# 以下均为公开的构建变量，不能放入 WordPress 密码或 Secret Key。
# 本地未配置时沿用开发地址；自动部署必须设置正式 HTTPS 地址。
# Pages 构建会校验该地址；请在 Pages 的生产和预览环境分别设置。
PUBLIC_GRAPHQL_URL=https://cms.example.com/graphql
# 可选；留空时停用前端 Turnstile，后台配置必须同步。
PUBLIC_TURNSTILE_SITE_KEY=
# 可选；GTM Web 容器 ID（GTM-XXXXXXX）。配置前先完成同意管理及隐私政策更新。
PUBLIC_GTM_ID=

# 仅供本地 Docker Compose 使用；自动部署由工作流生成独立配置。
BELARO_IMAGE=belaroprecision:local
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

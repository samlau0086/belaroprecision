---
import '../styles/global.css';
import 'flag-icons/css/flag-icons.min.css';
import { googleTagManagerId, site } from '../config';
import BackToTop from '../components/BackToTop.astro';
const { title = 'Precision CNC Machining for OEM Manufacturers', description = site.description, canonical } = Astro.props;
const pageTitle = title.includes('Belaro') ? title : `${title} | Belaro Precision`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.domain).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#101f35" />
    <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    {googleTagManagerId && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    </script>}
    {googleTagManagerId && <script async src={`https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(googleTagManagerId)}`}></script>}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    {googleTagManagerId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(googleTagManagerId)}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <slot />
    <BackToTop />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      const overlay = document.querySelector<HTMLButtonElement>('[data-menu-overlay]');
      if (toggle && menu && overlay) {
        const mobileViewport = window.matchMedia('(max-width: 1100px)');
        const background = [...document.querySelectorAll<HTMLElement>('main, .site-footer, [data-back-to-top]')];
        const previousInert = new Map<HTMLElement, boolean>();
        const setMenuOpen = (open: boolean, restoreFocus = false) => {
          const expanded = open && mobileViewport.matches;
          toggle.setAttribute('aria-expanded', String(expanded));
          menu.classList.toggle('is-open', expanded);
          overlay.hidden = !expanded;
          document.documentElement.classList.toggle('mobile-menu-open', expanded);
          // 保留背景原有的 inert 状态，避免关闭菜单时改变其他组件的约束。
          for (const element of background) {
            if (expanded) {
              if (!previousInert.has(element)) previousInert.set(element, element.inert);
              element.inert = true;
            } else if (previousInert.has(element)) {
              element.inert = previousInert.get(element)!;
            }
          }
          if (!expanded) {
            previousInert.clear();
            menu.querySelector('.mobile-capability-group')?.removeAttribute('open');
            if (restoreFocus) toggle.focus({ preventScroll: true });
          }
        };
        toggle.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        overlay.addEventListener('click', () => setMenuOpen(false, true));
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            event.preventDefault();
            setMenuOpen(false, true);
          }
        });
        menu.addEventListener('click', event => {
          if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
        });
        mobileViewport.addEventListener('change', () => {
          if (!mobileViewport.matches) {
            const focusInMenu = menu.contains(document.activeElement) || document.activeElement === toggle;
            setMenuOpen(false);
            if (focusInMenu) document.querySelector<HTMLAnchorElement>('.site-header .brand')?.focus({ preventScroll: true });
          }
        });
        window.addEventListener('pageshow', () => setMenuOpen(false));
      }
      document.querySelectorAll('[data-year]').forEach((el) => el.textContent = String(new Date().getFullYear()));
    </script>
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
interface Props { title: string; description: string; updated?: string; updatedLabel?: string; }
const { title, description, updated = '2026-11-05', updatedLabel = 'November 5, 2026' } = Astro.props;
const policies = [
  { href: '/privacy-policy/', title: 'Privacy Policy' },
  { href: '/cookie-policy/', title: 'Cookie Policy' },
  { href: '/terms-of-use/', title: 'Terms of Use' },
];
---
<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="page-hero page-hero-compact"><div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
      <span class="eyebrow eyebrow-light">BELARO / WEBSITE INFORMATION</span>
      <h1>{title}</h1><p>{description}</p><p class="updated">Last updated: <time datetime={updated}>{updatedLabel}</time></p>
    </div></section>
    <section class="section"><div class="container legal-grid">
      <aside><nav aria-label="Website policies">{policies.map(policy => <a href={policy.href} aria-current={Astro.url.pathname === policy.href ? 'page' : undefined}>{policy.title}<span aria-hidden="true">→</span></a>)}</nav><div class="legal-contact"><h2>Questions?</h2><p>Contact Belaro Precision about this notice or your enquiry.</p><a href={`mailto:${site.email}`}>{site.email}</a><a href="/contact/">Contact us →</a></div></aside>
      <article class="legal-content"><slot /></article>
    </div></section>
  </main><Footer />
</BaseLayout>
<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:13px;color:#c7d1dd}.updated{font-size:13px!important;margin:24px 0 0}.legal-grid{display:grid;grid-template-columns:260px minmax(0,1fr);gap:75px;align-items:start}.legal-grid aside{position:sticky;top:28px}.legal-grid aside nav{border-top:1px solid var(--line)}.legal-grid aside nav a{display:flex;justify-content:space-between;gap:12px;padding:16px 0;border-bottom:1px solid var(--line);font-weight:600}.legal-grid aside nav a[aria-current]{color:#a74b19}.legal-contact{background:var(--soft);padding:24px;margin-top:28px;overflow-wrap:anywhere}.legal-contact h2{font-size:23px;letter-spacing:-.5px;margin-bottom:12px}.legal-contact p{color:var(--muted);font-size:14px}.legal-contact a{display:block;font-size:14px;margin-top:12px}.legal-content{min-width:0;overflow-wrap:anywhere}.legal-content :global(h2){font-size:27px;line-height:1.3;letter-spacing:-.6px;margin:36px 0 16px}.legal-content :global(h2:first-child){margin-top:0}.legal-content :global(p),.legal-content :global(li){color:#465365}.legal-content :global(li){margin:8px 0}.legal-content :global(ul){padding-left:22px}.legal-content :global(a){text-decoration:underline;text-underline-offset:3px;color:#a74b19}.legal-grid a:focus-visible,.breadcrumbs a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:900px){.legal-grid{grid-template-columns:220px minmax(0,1fr);gap:36px}}
  @media(max-width:700px){.breadcrumbs{margin-bottom:28px}.legal-grid{grid-template-columns:minmax(0,1fr);gap:36px}.legal-grid aside{position:static}.legal-contact{margin-top:20px}.legal-content :global(h2){font-size:25px}}
</style>

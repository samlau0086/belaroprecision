---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { site } from '../../config';
import RfqForm from '../../components/RfqForm.astro';
import ProcessImage from '../../components/ProcessImage.astro';
---
<BaseLayout title="Request a CNC Machining Quote" description="Submit your CNC machining drawings, material, quantity and project requirements to Belaro Precision for review."><Header/><main><section class="page-hero page-hero-compact"><div class="container"><span class="eyebrow eyebrow-light">REQUEST FOR QUOTATION</span><h1>Tell us about<br/><em>your project.</em></h1><p>Share your drawing and key requirements. The more detail you provide, the more effectively we can review your enquiry.</p></div></section><section class="section"><div class="container rfq-layout"><div class="rfq-intro"><span class="eyebrow">START AN ENQUIRY</span><h2>Let’s review your<br/><em>machining needs.</em></h2><p>Use the form to tell us what you need manufactured. We may follow up to clarify dimensions, tolerances or material. We will provide an estimated lead time after reviewing your requirements.</p><div class="contact-detail"><span>COMPANY</span><p>{site.legalName}</p></div><div class="contact-detail"><span>Shenzhen Office</span><p>{site.location}</p></div><div class="contact-detail"><span>Dongguan CNC Factory</span><p>{site.factoryLocation}</p></div><div class="contact-detail"><span>EMAIL</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-detail"><span>WHATSAPP</span><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.whatsapp}</a></div><div class="contact-detail"><span>WHAT TO PREPARE</span><p>2D drawing, 3D CAD file, material specification, quantity and critical requirements.</p></div><div class="rfq-image"><ProcessImage name="contact-rfq" alt="Technical and commercial review of a machining drawing and CAD model" width={1586} height={992} /></div><div class="privacy-note">Your drawings may contain confidential technical information. Avoid uploading sensitive files until suitable confidentiality arrangements have been agreed.</div></div><RfqForm /></div></section></main><Footer/></BaseLayout>

<style>
  .rfq-image{margin:20px 0}.rfq-image :global(.process-image){border:1px solid var(--line)}
</style>

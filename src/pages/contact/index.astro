---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { site } from '../../config';
import CountrySelect from '../../components/CountrySelect.astro';
import PhoneField from '../../components/PhoneField.astro';
import MaterialSelect from '../../components/MaterialSelect.astro';
import { gravityForms } from '../../config';
---
<BaseLayout title="Request a CNC Machining Quote" description="Submit your CNC machining drawings, material, quantity and project requirements to Belaro Precision for review."><Header/><main><section class="page-hero page-hero-compact"><div class="container"><span class="eyebrow eyebrow-light">REQUEST FOR QUOTATION</span><h1>Tell us about<br/><em>your project.</em></h1><p>Share your drawing and key requirements. The more detail you provide, the more effectively we can review your enquiry.</p></div></section><section class="section"><div class="container rfq-layout"><div class="rfq-intro"><span class="eyebrow">START AN ENQUIRY</span><h2>Let’s review your<br/><em>machining needs.</em></h2><p>Use the form to tell us what you need manufactured. We may follow up to clarify dimensions, tolerances or material. We will provide an estimated lead time after reviewing your requirements.</p><div class="contact-detail"><span>COMPANY</span><p>{site.legalName}</p></div><div class="contact-detail"><span>LOCATION</span><p>{site.location}</p></div><div class="contact-detail"><span>EMAIL</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-detail"><span>WHATSAPP</span><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.whatsapp}</a></div><div class="contact-detail"><span>WHAT TO PREPARE</span><p>2D drawing, 3D CAD file, material specification, quantity and critical requirements.</p></div><div class="privacy-note">Your drawings may contain confidential technical information. Avoid uploading sensitive files until suitable confidentiality arrangements have been agreed.</div></div><form class="rfq-form" id="rfq-form" data-gravity-forms={JSON.stringify(gravityForms)}  method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_subject" value="New RFQ — Belaro Precision"/><div class="form-heading"><h3>RFQ Details</h3><span>* Required fields</span></div>
  <div class="form-grid"><label>Full name *<input name="name" autocomplete="name" required placeholder="Your name"/></label><label>Business email *<input type="email" name="email" autocomplete="email" required placeholder="name@company.com"/></label><label>Company name *<input name="company" autocomplete="organization" required placeholder="Company Ltd."/></label><CountrySelect/><PhoneField/><div class="full-field file-upload">
    <label class="file-upload-label" for="drawing-file">Upload drawing or CAD file</label>
    <div class="file-drop" data-file-drop>
      <svg class="file-drop-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
      <span class="file-drop-title">Drag &amp; drop your file here</span>
      <span class="file-drop-browse">or <span>browse files</span></span>
      <input class="file-drop-input" id="drawing-file" type="file" name="attachment" accept=".pdf,.step,.stp,.iges,.igs,.x_t,.dwg,.dxf,.zip" aria-describedby="drawing-confidentiality drawing-help drawing-status drawing-error"/>
    </div>
    <p class="file-confidentiality" id="drawing-confidentiality"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>Files kept confidential, used only to quote and make your parts. <a href="/privacy-policy/">Privacy policy</a></span></p>
    <small id="drawing-help">Accepted formats: PDF, STEP, STP, IGES, IGS, X_T, DWG, DXF or ZIP. Maximum file size: 20 MB.</small>
    <div class="file-selection" data-file-selection hidden>
      <span id="drawing-status" role="status"></span>
      <button class="file-remove" type="button" data-file-remove aria-label="Remove selected file">Remove</button>
    </div>
    <p class="file-error" id="drawing-error" role="alert" hidden></p>
  </div><details class="rfq-optional full-field">
    <summary><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg><span>Add details (optional)<small>Process, material, quantity, tolerances, documents and project notes</small></span></summary>
    <div class="form-grid optional-fields"><label>Machining process<select name="process"><option value="">Select process</option><option>CNC Milling</option><option>CNC Turning</option><option>Not sure — please review</option></select></label><MaterialSelect/><label>Estimated quantity<select name="quantity"><option value="">Select quantity</option><option>1–19 pcs</option><option>20–50 pcs</option><option>51–100 pcs</option><option>101–500 pcs</option><option>More than 500 pcs</option><option>Recurring / annual demand</option></select></label><label class="full-field">Tolerance / critical requirements<textarea name="tolerance" rows="3" placeholder="List critical dimensions, tolerances, surface finish or inspection requirements."></textarea></label><fieldset class="document-options full-field" aria-describedby="documents-help">
      <legend>Documents you need</legend>
      <div class="document-choices">
        <label><input type="checkbox" name="documents" value="FAI report"/>FAI report</label>
        <label><input type="checkbox" name="documents" value="CMM / dimensional report"/>CMM / dimensional report</label>
        <label><input type="checkbox" name="documents" value="EN 10204 3.1 material cert"/>EN 10204 3.1 material cert</label>
      </div>
      <p id="documents-help">Document availability and scope will be confirmed during quotation.</p>
    </fieldset><label class="full-field">Project details<textarea name="details" rows="4" placeholder="Describe the component, application, quantity forecast or any other useful details."></textarea></label></div>
  </details><label class="consent full-field"><input type="checkbox" name="consent" checked required aria-describedby="enquiry-privacy"/> I agree that Belaro Precision may contact me about this enquiry. *</label><p class="full-field enquiry-privacy" id="enquiry-privacy">Read our <a href="/privacy-policy/">Privacy Policy</a> for how we handle your contact details and technical files. This enquiry does not subscribe you to marketing emails. See also our <a href="/terms-of-use/">Terms of Use</a>.</p></div>
  <div class="turnstile-wrap full-field"><div class="cf-turnstile" data-sitekey={gravityForms.turnstileSiteKey} data-action="rfq" data-theme="light"></div></div><button class="button button-orange button-large" type="submit" disabled>Submit RFQ <span>↗</span></button><noscript><p>Please enable JavaScript to submit this form, or contact us by email.</p></noscript><p class="form-status" id="form-status" aria-live="polite">Please do not submit export-controlled or highly sensitive technical data without first agreeing appropriate handling arrangements.</p>
</form></div></section></main><Footer/><script>
  import type { gravityForms as GravityFormsConfig } from '../../config';
  import { submissionRequest, submissionResult } from '../../lib/gravity-forms.mjs';
  import { machinedParts } from '../../data/machined-parts';
  declare global { interface Window { turnstile?: { render: (target: HTMLElement, options: Record<string, unknown>) => string; reset: () => void } } }
  const form = document.querySelector<HTMLFormElement>('#rfq-form');
  // 仅接受已定义的零件标识；不将任意 URL 文本写入表单，也不覆盖已有输入。
  const query = new URLSearchParams(location.search);
  const requestedPart = machinedParts.find(part => part.id === query.get('part'));
  if (requestedPart && form) {
    const process = form.querySelector<HTMLSelectElement>('[name="process"]');
    const details = form.querySelector<HTMLTextAreaElement>('[name="details"]');
    if (process && !process.value) process.value = requestedPart.process;
    if (details && !details.value) details.value = `Part family: ${requestedPart.title}\nPlease describe your component and project requirements.`;
  }
  // 工艺入口采用固定白名单；零件分类入口优先，不覆盖已填写字段。
  if (query.get('process') === 'milling' && form) {
    const process = form.querySelector<HTMLSelectElement>('[name="process"]');
    if (process && !process.value) process.value = 'CNC Milling';
  }
  if (query.get('process') === 'turning' && form) {
    const process = form.querySelector<HTMLSelectElement>('[name="process"]');
    if (process && !process.value) process.value = 'CNC Turning';
  }
  const gravityForms: typeof GravityFormsConfig = JSON.parse(form?.dataset.gravityForms || '{}');
  const status = document.querySelector('#form-status');
  const fileInput = document.querySelector<HTMLInputElement>('#drawing-file');
  const dropZone = document.querySelector<HTMLElement>('[data-file-drop]');
  const selection = document.querySelector<HTMLElement>('[data-file-selection]');
  const fileStatus = document.querySelector<HTMLElement>('#drawing-status');
  const fileError = document.querySelector<HTMLElement>('#drawing-error');
  const removeFile = document.querySelector<HTMLButtonElement>('[data-file-remove]');

  if (fileInput && dropZone && selection && fileStatus && fileError && removeFile) {
    let dragDepth = 0;
    const updateSelection = () => {
      const file = fileInput.files?.[0];
      selection.hidden = !file;
      dropZone.classList.toggle('has-file', Boolean(file));
      fileStatus.textContent = file ? `${file.name} (${file.size < 1024 * 1024 ? (file.size / 1024).toFixed(1) + ' KB' : (file.size / (1024 * 1024)).toFixed(1) + ' MB'})` : '';
    };
    const validateFiles = (files: FileList | null) => {
      const file = files?.[0];
      const message = files && files.length > 1
        ? 'Please select one file. Combine multiple drawings in a ZIP file.'
        : file && !/\.(pdf|step|stp|iges|igs|x_t|dwg|dxf|zip)$/i.test(file.name)
          ? 'Please choose a supported drawing, CAD or ZIP file.'
          : file && file.size > 20 * 1024 * 1024
            ? 'Please choose a file no larger than 20 MB.'
            : '';
      fileError.textContent = message;
      fileError.hidden = !message;
      fileInput.setAttribute('aria-invalid', String(Boolean(message)));
      return !message;
    };
    fileInput.addEventListener('change', () => {
      if (!validateFiles(fileInput.files)) fileInput.value = '';
      updateSelection();
    });
    dropZone.addEventListener('dragenter', (event) => {
      event.preventDefault();
      dragDepth++;
      dropZone.classList.add('is-dragging');
    });
    dropZone.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
    });
    dropZone.addEventListener('dragleave', (event) => {
      event.preventDefault();
      if (--dragDepth <= 0) {
        dragDepth = 0;
        dropZone.classList.remove('is-dragging');
      }
    });
    dropZone.addEventListener('drop', (event) => {
      event.preventDefault();
      dragDepth = 0;
      dropZone.classList.remove('is-dragging');
      const files = event.dataTransfer?.files;
      if (files?.length && validateFiles(files)) {
        fileInput.files = files;
        updateSelection();
      }
    });
    removeFile.addEventListener('click', () => {
      fileInput.value = '';
      validateFiles(null);
      updateSelection();
      fileInput.focus();
    });
    form?.addEventListener('reset', () => {
      fileInput.value = '';
      validateFiles(null);
      updateSelection();
    });
  }
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const turnstileWidget = form?.querySelector<HTMLElement>('.cf-turnstile');
  let turnstileToken = '';
  let resettingTurnstile = false;
  const turnstileEnabled = Boolean(gravityForms.turnstileSiteKey?.trim());
  if (!turnstileEnabled) {
    turnstileWidget?.parentElement?.setAttribute('hidden', '');
    if (submitButton) submitButton.disabled = false;
  } else if (!turnstileWidget) {
    if (status) status.textContent = 'Online enquiries are temporarily unavailable. Please contact us by email.';
  } else {
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.addEventListener('load', () => {
      const api = window.turnstile;
      if (!api || !turnstileWidget) return;
      api.render(turnstileWidget, {
        sitekey: gravityForms.turnstileSiteKey,
        action: 'rfq',
        callback: (token: string) => {
          if (resettingTurnstile) return;
          turnstileToken = token;
          if (submitButton && !submitted) submitButton.disabled = false;
        },
        'expired-callback': () => { turnstileToken = ''; if (submitButton) submitButton.disabled = true; },
        'error-callback': () => { turnstileToken = ''; if (submitButton) submitButton.disabled = true; },
      });
    });
    document.head.append(script);
  }
  let submitting = false;
  let submitted = false;
  const markFormChanged = () => {
    if (!submitted || submitting) return;
    submitted = false;
    submitButton!.innerHTML = 'Submit RFQ <span>↗</span>';
    status!.dataset.state = 'idle';
    status!.textContent = 'Your enquiry has changed. Please submit it again.';
    if (turnstileEnabled) {
      turnstileToken = '';
      submitButton!.disabled = true;
      resettingTurnstile = true;
      window.turnstile?.reset();
      queueMicrotask(() => { resettingTurnstile = false; });
    } else {
      submitButton!.disabled = false;
    }
  };
  form?.addEventListener('input', markFormChanged);
  form?.addEventListener('change', markFormChanged);
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (submitting || submitted || !submitButton || !status) return;
    form.querySelectorAll('[data-gf-error]').forEach(error => error.remove());
    form.querySelectorAll('[data-gf-invalid]').forEach(input => {
      input.removeAttribute('aria-invalid');
      input.removeAttribute('data-gf-invalid');
      const ids = input.getAttribute('aria-describedby')?.split(' ').filter(id => !id.startsWith('gf-error-'));
      if (ids?.length) input.setAttribute('aria-describedby', ids.join(' '));
      else input.removeAttribute('aria-describedby');
    });
    if (!form.reportValidity()) return;
    let request;
    try {
      request = submissionRequest(new FormData(form), gravityForms, turnstileToken);
    } catch {
      status.textContent = 'Online enquiries are temporarily unavailable. Please contact us by email.';
      status.dataset.state = 'error';
      return;
    }
    submitting = true;
    submitButton.disabled = true;
    form.setAttribute('aria-busy', 'true');
    status.dataset.state = 'pending';
    status.textContent = 'Submitting your enquiry…';
    try {
      const response = await fetch(request.url, request.init);
      const result = submissionResult(response.ok, await response.json());
      if (result.is_valid === false && result.validation_messages && typeof result.validation_messages === 'object') {
        let firstInvalid: HTMLElement | undefined;
        for (const [fieldId, message] of Object.entries(result.validation_messages)) {
          if (typeof message !== 'string') continue;
          const entry = Object.entries(gravityForms.fields).find(([, value]) => value.id === Math.trunc(Number(fieldId)));
          const input = entry && form.querySelector<HTMLElement>(`[name="${entry[0]}"]`);
          const error = document.createElement('span');
          error.className = 'gf-field-error';
          error.dataset.gfError = '';
          // Gravity Forms validation messages may contain HTML; display text only.
          error.textContent = new DOMParser().parseFromString(message, 'text/html').body.textContent || 'Please check this field.';
          if (input instanceof HTMLElement) {
            // 展开包含后台错误的区域，确保错误字段可见并能够聚焦。
            const optionalSection = input.closest('details');
            if (optionalSection) optionalSection.open = true;
            error.id = `gf-error-${entry![0]}`;
            input.setAttribute('aria-invalid', 'true');
            input.dataset.gfInvalid = '';
            input.setAttribute('aria-describedby', `${input.getAttribute('aria-describedby') || ''} ${error.id}`.trim());
            (input.closest('fieldset') || input.closest('label, .country-field, .file-upload') || input.parentElement)?.append(error);
            firstInvalid ??= input;
          } else {
            status.after(error);
          }
        }
        status.textContent = 'Please check the highlighted fields and try again.';
        status.dataset.state = 'error';
        firstInvalid?.focus();
      } else if (response.ok && result.is_valid === true) {
        submitted = true;
        status.textContent = 'Thank you. Your enquiry has been received. We will contact you about your project.';
        status.dataset.state = 'success';
        submitButton.textContent = 'RFQ submitted ✓';
      } else {
        throw new Error('Submission was not confirmed.');
      }
    } catch {
      status.textContent = 'We could not confirm receipt of your enquiry. Your details have been kept. Please contact us by email, or check before submitting again.';
      status.dataset.state = 'error';
    } finally {
      turnstileToken = '';
      window.turnstile?.reset();
      submitting = false;
      submitButton.disabled = submitted || (turnstileEnabled && !turnstileToken);
      form.removeAttribute('aria-busy');
    }
  });
</script></BaseLayout>

<style>
  .rfq-optional{min-width:0;border:1px solid #d6dfea;border-radius:6px;background:#fff}
  .rfq-optional summary{display:flex;align-items:center;gap:10px;padding:16px;cursor:pointer;list-style:none;font-size:15px;font-weight:700;line-height:1.5}
  .rfq-optional summary::-webkit-details-marker{display:none}
  .rfq-optional summary svg{flex:none;color:var(--navy);transition:transform .2s}
  .rfq-optional[open] summary svg{transform:rotate(90deg)}
  .rfq-optional summary small{display:block;font-size:13px;font-weight:400;color:var(--muted);margin-top:3px}
  .rfq-optional summary:focus-visible{outline:2px solid var(--orange);outline-offset:3px;border-radius:6px}
  .optional-fields{padding:0 16px 18px;min-width:0}
  .optional-fields>label{min-width:0}
  .document-options{min-width:0;margin:0;padding:0;border:0}
  .document-options legend{font-size:16px;font-weight:700;color:#344256;margin-bottom:10px;padding:0}
  .document-choices{display:flex;flex-wrap:wrap;gap:12px 20px}
  .document-choices label{flex-direction:row;align-items:center;gap:8px;font-size:14px;font-weight:400}
  .document-choices input[type=checkbox]{width:18px;height:18px;margin:0;flex:none;accent-color:var(--orange)}
  .document-options p{margin:10px 0 0;color:var(--muted);font-size:13px;line-height:1.6}
  @media(max-width:700px){.rfq-optional summary{padding:14px 12px}.optional-fields{padding:0 12px 16px}.document-choices{flex-direction:column;gap:10px}}

  .rfq-form :global(.gf-field-error){display:block;color:#ae3023;font-size:14px;font-weight:400;margin-top:5px}
  .rfq-form :global([aria-invalid=true]){border-color:#ae3023}
  .form-status[data-state=error]{color:#ae3023}
  .form-status[data-state=success]{color:#267344}
  .rfq-form>.button:disabled{opacity:.7;cursor:default;transform:none}
  .enquiry-privacy{font-size:14px;color:var(--muted);margin:0}.enquiry-privacy a{text-decoration:underline;text-underline-offset:3px;color:#a74b19}.enquiry-privacy a:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
  .rfq-form :global(.consent){align-items:center!important}
  .rfq-form :global(.consent input){margin:0 4px 0 0}
  .file-upload{display:flex;flex-direction:column;gap:10px;min-width:0}
  .file-upload-label{font-size:16px;font-weight:700;color:#344256}
  .file-drop{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:195px;padding:28px 20px;border:2px dashed #cbd3dc;background:var(--soft);text-align:center;transition:border-color .2s,background-color .2s}
  .file-drop:hover,.file-drop:focus-within,.file-drop.is-dragging{border-color:var(--orange);background:#fff5ed}
  .file-drop:focus-within{outline:2px solid var(--orange);outline-offset:3px}
  .file-drop.has-file{border-color:var(--orange)}
  .file-drop-icon{color:var(--orange);margin-bottom:4px;flex-shrink:0}
  .file-drop-title{font-size:16px;font-weight:700;color:var(--ink)}
  .file-drop-browse{font-size:16px;color:var(--muted)}
  .file-drop-browse span{color:var(--orange2);font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .file-upload .file-drop-input{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;opacity:0;cursor:pointer;font-size:16px}
  .file-upload small{font-size:16px;color:var(--muted);line-height:1.6}
  .file-confidentiality{display:flex;align-items:flex-start;gap:9px;margin:0;font-size:13px;line-height:1.6;color:var(--muted)}
  .file-confidentiality svg{flex-shrink:0;margin-top:2px;color:var(--orange2)}
  .file-confidentiality a{color:var(--orange2);text-decoration:underline;text-underline-offset:3px}
  .file-confidentiality a:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
  .file-selection{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 15px;background:var(--soft);border:1px solid var(--line);font-size:16px}
  .file-selection[hidden],.file-error[hidden]{display:none}
  .file-selection>span{min-width:0;overflow-wrap:anywhere}
  .file-remove{flex-shrink:0;border:0;background:transparent;color:var(--orange2);font:600 16px var(--font);cursor:pointer;padding:6px;text-decoration:underline;text-underline-offset:3px}
  .file-remove:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
  .file-error{font-size:16px;color:#ae3023;margin:0}
</style>

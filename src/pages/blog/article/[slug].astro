---
import BlogArticle from '../../../components/BlogArticle.astro';
import { gravityForms } from '../../../config';
import { fetchPublishedBlogPosts } from '../../../lib/blog.mjs';

export async function getStaticPaths() {
  const posts = await fetchPublishedBlogPosts(gravityForms.graphqlUrl);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BlogArticle post={post} />
<script>
  const slug = window.location.pathname.match(/^\/blog\/article\/([^/]+)\/?$/)?.[1];
  if (slug) window.location.replace(`/post/${slug}/${window.location.search}${window.location.hash}`);
</script>

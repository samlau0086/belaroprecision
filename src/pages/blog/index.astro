---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { gravityForms } from '../../config';

const endpoint = gravityForms.graphqlUrl;
---

<BaseLayout title="Blog | Belaro Precision" description="Insights, updates, and practical guides from Belaro Precision.">
  <Header />
  <main class="blog-page" data-blog-root data-endpoint={endpoint}>
    <section class="blog-heading" aria-labelledby="blog-title">
      <div class="heading-inner">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Blog</span></nav>
        <p class="blog-eyebrow">The Belaro journal</p>
        <h1 id="blog-title">Blog</h1>
        <p class="blog-intro">Ideas, insights, and a closer look at precision manufacturing.</p>
      </div>
    </section>
    <section class="blog-content" aria-label="Articles">
      <div class="blog-toolbar"><h2>Latest articles</h2><span data-blog-count></span></div>
      <div class="blog-filters" data-blog-filters role="group" aria-label="Filter by category" hidden></div>
      <p class="blog-status" data-blog-status role="status" aria-live="polite"></p>
      <div class="blog-grid" data-blog-grid aria-busy="true" aria-label="Loading articles">
        {[1, 2, 3].map(() => <div class="blog-skeleton" aria-hidden="true"><div class="skeleton-media skeleton" /><div class="skeleton-body"><div class="skeleton skeleton-label" /><div class="skeleton skeleton-title" /><div class="skeleton skeleton-line" /><div class="skeleton skeleton-line short" /></div></div>)}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { articlePath, fetchBlogData, plainText } from '../../lib/blog.mjs';

  const root = document.querySelector('[data-blog-root]');
  const filterContainer = root?.querySelector('[data-blog-filters]');
  const status = root?.querySelector('[data-blog-status]');
  const grid = root?.querySelector('[data-blog-grid]');

  if (root && filterContainer && status && grid) {
    try {
      const { categories, posts } = await fetchBlogData(root.dataset.endpoint);
      const availableIds = new Set(posts.flatMap(post => (post.categories?.nodes || []).map(category => category.databaseId)));
      const filters = [{ databaseId: 'all', name: 'All articles' }, ...categories.filter(category => availableIds.has(category.databaseId))];
      let activeCategory = 'all';

      const render = () => {
        filterContainer.replaceChildren();
        filters.forEach(category => {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = category.name;
          button.setAttribute('aria-pressed', String(String(category.databaseId) === activeCategory));
          button.addEventListener('click', () => {
            activeCategory = String(category.databaseId);
            render();
          });
          filterContainer.append(button);
        });

        const visiblePosts = activeCategory === 'all' ? posts : posts.filter(post => (post.categories?.nodes || []).some(category => String(category.databaseId) === activeCategory));
        grid.replaceChildren();
        visiblePosts.forEach(post => {
          const article = document.createElement('article');
          article.className = 'blog-card';
          const media = document.createElement('a');
          media.className = 'blog-card-media';
          media.href = articlePath(post.slug);
          media.tabIndex = -1;
          media.setAttribute('aria-hidden', 'true');
          const imageUrl = post.featuredImage?.node?.sourceUrl;
          let hasImage = false;
          if (imageUrl) {
            try {
              const parsed = new URL(imageUrl);
              if (parsed.protocol === 'https:' || parsed.protocol === 'http:') {
                const image = document.createElement('img');
                image.src = parsed.href;
                image.alt = post.featuredImage.node.altText || '';
                image.loading = 'lazy';
                media.append(image);
                hasImage = true;
              }
            } catch { /* 忽略无效的 WordPress 图片地址 */ }
          }
          if (!hasImage) {
            media.classList.add('is-fallback');
            const image = document.createElement('img');
            image.src = '/images/machined-parts/machined-block-main.webp';
            image.alt = '';
            image.loading = 'lazy';
            media.append(image);
          }
          article.append(media);
          const body = document.createElement('div');
          body.className = 'blog-card-body';
          const categoriesLabel = document.createElement('p');
          categoriesLabel.className = 'blog-card-category';
          categoriesLabel.textContent = (post.categories?.nodes || []).map(category => category.name).join(' · ');
          const title = document.createElement('h2');
          const link = document.createElement('a');
          if (/^[a-z0-9][a-z0-9-]*$/i.test(post.slug || '')) {
            link.href = articlePath(post.slug);
            link.textContent = plainText(post.title) || 'Read article';
            title.append(link);
          } else title.textContent = plainText(post.title) || 'Article';
          const date = document.createElement('time');
          date.className = 'blog-card-date';
          if (post.date && !Number.isNaN(Date.parse(post.date))) {
            date.dateTime = post.date;
            date.textContent = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(new Date(post.date));
          }
          const excerpt = document.createElement('p');
          excerpt.className = 'blog-card-excerpt';
          excerpt.textContent = plainText(post.excerpt);
          const read = document.createElement('a');
          read.className = 'blog-card-read';
          read.href = articlePath(post.slug);
          read.textContent = 'Read article';
          read.setAttribute('aria-label', `Read article: ${plainText(post.title)}`);
          const arrow = document.createElement('span');
          arrow.textContent = '↗';
          arrow.setAttribute('aria-hidden', 'true');
          read.append(arrow);
          body.append(categoriesLabel, title, date, excerpt, read);
          article.append(body);
          grid.append(article);
        });
        status.textContent = visiblePosts.length ? '' : 'No articles in this category yet.';
        root.querySelector('[data-blog-count]').textContent = `${visiblePosts.length} ${visiblePosts.length === 1 ? 'article' : 'articles'}`;
      };

      filterContainer.hidden = categories.length === 0;
      render();
    } catch {
      grid.replaceChildren();
      status.textContent = 'Articles are temporarily unavailable. Please try again later.';
    } finally {
      grid.setAttribute('aria-busy', 'false');
      grid.removeAttribute('aria-label');
    }
  }
</script>

<style>
  .blog-page { min-height: 65vh; background: #fff; }
  .blog-heading { background: #f4f6f8; border-bottom: 1px solid #e3e8ee; padding: 1.5rem 1.5rem 3.5rem; }
  .heading-inner { max-width: 1160px; margin: auto; }
  .blog-breadcrumb { display: flex; gap: .7rem; color: #687586; font-size: .82rem; margin-bottom: 2.25rem; }
  .blog-eyebrow { margin: 0 0 .5rem; color: #b84b15; font-size: .75rem; font-weight: 700; text-transform: uppercase; }
  .blog-heading h1 { margin: 0; font-size: 3.5rem; line-height: 1.15; }
  .blog-intro { max-width: 42rem; margin: 1rem 0 0; color: #687586; font-size: 1.05rem; }
  .blog-content { max-width: 1208px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }
  .blog-toolbar { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .blog-toolbar h2 { margin: 0; font-size: 1.45rem; }
  .blog-toolbar > span { color: #687586; font-size: .85rem; }
  .blog-filters { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid #e3e8ee; }
  .blog-filters[hidden] { display: none; }
  .blog-filters :global(button) { min-height: 46px; padding: .4rem 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #687586; font: inherit; font-size: .9rem; cursor: pointer; }
  .blog-filters :global(button[aria-pressed="true"]) { border-bottom-color: #f47b35; color: #172338; font-weight: 700; }
  .blog-status { color: #536273; }
  .blog-status:empty { display: none; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem; }
  .blog-grid :global(.blog-card), .blog-skeleton { overflow: hidden; border: 1px solid #e3e8ee; border-radius: 6px; background: #fff; }
  .blog-grid :global(.blog-card) { transition: border-color .2s, box-shadow .2s; }
  .blog-grid :global(.blog-card:hover) { border-color: #c6cfd7; box-shadow: 0 8px 24px #1723380a; }
  .blog-grid :global(.blog-card-media) { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #f4f6f8; border-bottom: 1px solid #e3e8ee; }
  .blog-grid :global(.blog-card-media img) { width: 100%; height: 100%; object-fit: cover; }
  .blog-grid :global(.blog-card-media.is-fallback img) { object-fit: contain; padding: 1rem; }
  .blog-grid :global(.blog-card-body) { padding: 1.5rem; }
  .blog-grid :global(.blog-card-category) { margin: 0 0 .65rem; color: #b84b15; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .blog-grid :global(.blog-card-date) { color: #687586; font-size: .8rem; }
  .blog-grid :global(.blog-card h2) { margin: 0 0 .7rem; font-size: 1.4rem; line-height: 1.4; overflow-wrap: anywhere; }
  .blog-grid :global(.blog-card h2 a:hover) { color: #b84b15; }
  .blog-grid :global(.blog-card-excerpt) { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: #687586; line-height: 1.7; font-size: .94rem; margin: .9rem 0 1.5rem; }
  .blog-grid :global(.blog-card-read) { display: flex; align-items: center; justify-content: space-between; min-height: 36px; border-top: 1px solid #e3e8ee; padding-top: 1rem; font-size: .85rem; font-weight: 700; }
  .blog-grid :global(.blog-card-read span) { color: #b84b15; font-size: 1.25rem; }
  .blog-content :global(a:focus-visible), .blog-content :global(button:focus-visible) { outline: 2px solid #f47b35; outline-offset: 4px; }
  .skeleton { background: #e8edf1; animation: skeleton-pulse 1.4s ease-in-out infinite alternate; border-radius: 3px; }
  .skeleton-media { aspect-ratio: 16 / 10; border-radius: 0; }
  .skeleton-body { padding: 1.5rem; }
  .skeleton-label { width: 30%; height: .7rem; margin-bottom: 1.3rem; }
  .skeleton-title { width: 80%; height: 1.5rem; margin-bottom: 1.7rem; }
  .skeleton-line { height: .85rem; margin-bottom: .85rem; }
  .skeleton-line.short { width: 65%; }
  @keyframes skeleton-pulse { to { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
  @media (max-width: 800px) { .blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .blog-grid { grid-template-columns: 1fr; } .blog-heading h1 { font-size: 2.5rem; } .blog-heading { padding-bottom: 2.5rem; } .blog-content { padding-top: 2rem; } }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SecondaryProcessSupport from '../../components/SecondaryProcessSupport.astro';
import { site } from '../../config';

const capabilities = [
  { title: 'CNC Milling', text: '3-axis machining for prismatic components, mounting features and pockets, with simultaneous 5-axis machining available for more complex geometry.', href: '/services/cnc-milling/', label: 'Explore CNC Milling' },
  { title: 'CNC Turning', text: 'Drawing-based shafts, bushings, sleeves and connectors, with attention to mating diameters, shoulders, threads and functional surfaces.', href: '/services/cnc-turning/', label: 'Explore CNC Turning' },
  { title: 'OEM & Low-Volume Production', text: 'A focus on manageable batches and repeat requirements, with drawing revision, quantity, inspection and delivery aligned for each order.', href: '/services/production/', label: 'Explore OEM production' },
];

const workflow = [
  { title: 'Understand the requirement', text: 'Start with your drawing, available model, material, quantity and application. Identify the revision and the features that matter to assembly or performance.' },
  { title: 'Align the manufacturing scope', text: 'Review machining, secondary processes, inspection records and target delivery. Clarify technical questions and the scope included in the quotation.' },
  { title: 'Confirm before production', text: 'Agree the drawing revision, acceptance criteria and commercial requirements before work begins. Any proposed requirement changes should be reviewed together.' },
  { title: 'Plan for the next order', text: 'For repeat requirements, reconfirm revision status, quantity and delivery needs. Review design changes rather than assuming an earlier specification still applies.' },
];

const principles = [
  { label: '01 / CLARITY', title: 'Understand the drawing.', text: 'Clear technical and commercial requirements give both teams a shared basis for the work. Questions should be resolved before they become production assumptions.' },
  { label: '02 / FOCUS', title: 'Match the part to the process.', text: 'Geometry, material and inspection requirements determine whether a job is a fit. Feasibility and any limitations belong in the review and quotation.' },
  { label: '03 / CONSISTENCY', title: 'Think beyond one order.', text: 'OEM supply involves revisions, repeat demand and changing schedules. Our approach centres on clear communication and agreed requirements at each stage.' },
];
---

<BaseLayout title="About Belaro Precision | CNC Machining for OEM Manufacturers" description="Based in Shenzhen, Belaro Precision focuses on drawing-based CNC milling, turning and low-volume OEM components, with coordinated secondary process support.">
  <Header />
  <main>
    <section class="page-hero about-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About Belaro</span></nav>
        <div class="about-hero-grid">
          <div><span class="eyebrow eyebrow-light">ABOUT BELARO / SHENZHEN, CHINA</span><h1>Precision parts.<br/><em>Clear communication.</em></h1><p>Precision CNC machining for OEM manufacturers. Drawing-based components, a focused production approach and a practical connection to the manufacturing networks in Dongguan and Shenzhen.</p><div class="hero-actions"><a class="button button-orange" href="/contact/#rfq-form">Discuss Your Project <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#our-approach">Meet Belaro <span aria-hidden="true">↓</span></a></div></div>
          <aside class="company-profile" aria-labelledby="profile-heading"><span class="profile-label">BELARO AT A GLANCE</span><h2 id="profile-heading">Built around<br/>your component.</h2><dl><div><dt>Location</dt><dd>{site.location}</dd></div><div><dt>Core processes</dt><dd>CNC Milling & CNC Turning</dd></div><div><dt>Milling capability</dt><dd>3-axis & simultaneous 5-axis</dd></div><div><dt>Production focus</dt><dd>Low-volume & repeat OEM orders</dd></div></dl><a href="/services/">View our capabilities <span aria-hidden="true">→</span></a></aside>
        </div>
      </div>
    </section>

    <section class="section" id="our-approach"><div class="container intro-grid"><div><span class="eyebrow">OUR POSITION</span><h2>Focused on the parts behind <em>your products.</em></h2></div><div><p class="lead">Belaro Precision focuses on supplying drawing-based CNC-machined components to industrial OEM manufacturers and engineering businesses.</p><p>Our work starts with your component: how it fits, which features are critical and what the finished part needs to achieve. We review the drawing, material, production quantity and inspection requirements together so that the manufacturing scope is clear.</p><p>We focus on low-volume production and repeat component requirements. For purchasing and engineering teams sourcing overseas, that means an approach centred on technical clarity, practical production planning and communication throughout the order.</p><a class="text-link" href="/machined-parts/">Explore component families <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section section-soft"><div class="container"><SectionHeading eyebrow="WHAT WE DO" title="Machining at the core. Your drawing as the reference." text="Our CNC capabilities support custom industrial components. The suitable process, achievable requirements and delivery scope are confirmed after reviewing each part."/><div class="about-capabilities">{capabilities.map((capability, index) => <article><span class="card-number">0{index + 1} / CAPABILITY</span><h3>{capability.title}</h3><p>{capability.text}</p><a class="text-link" href={capability.href}>{capability.label} <span aria-hidden="true">→</span></a></article>)}</div><div class="application-note"><p>Application areas include industrial automation, industrial machinery, hydraulic and pneumatic equipment, and laboratory and testing equipment.</p><a class="text-link" href="/industries/">Explore applications <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section section-soft"><div class="container"><span class="eyebrow">COMPANY INFORMATION</span><h2>{site.legalName}</h2><p>Belaro Precision is the brand used on this website by {site.legalName}, based in {site.location}.</p></div></section>
    <SecondaryProcessSupport eyebrow="REGIONAL SUPPLIER NETWORK" title="Regional manufacturing depth. Flexible support beyond machining." text="Based in Shenzhen, we draw on the manufacturing ecosystems and supplier networks in Dongguan and Shenzhen. This allows us to coordinate grinding, heat treatment, surface finishing and other secondary processes around your component. The route, supplier scope, specifications and requested records are agreed per project." />

    <section class="section section-soft" id="working-together"><div class="container"><SectionHeading eyebrow="WORKING WITH BELARO" title="A clear path from drawing to repeat requirement" text="Good manufacturing relationships are built on shared expectations. This is how we approach the conversation, from an initial enquiry to the next batch."/><ol class="working-steps">{workflow.map((step, index) => <li><span class="step-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol><a class="text-link" href="/services/production/">Our production approach <span aria-hidden="true">→</span></a></div></section>

    <section class="section"><div class="container"><SectionHeading eyebrow="HOW WE THINK" title="Three principles behind the work"/><div class="about-principles">{principles.map(principle => <article><span>{principle.label}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div></div></section>

    <section class="quality-band"><div class="container about-quality"><div><span class="eyebrow eyebrow-light">QUALITY & TECHNICAL ALIGNMENT</span><h2>Agree what matters.<br/><em>Define how it is checked.</em></h2><p>Critical dimensions, material requirements, final surface condition and inspection records should be part of the discussion before production. The same applies when secondary processes form part of the agreed route.</p><a class="button button-white" href="/quality/">Our Quality Approach <span aria-hidden="true">↗</span></a></div><div class="quality-review"><h3>Bring these to the review</h3><ul><li>The current drawing revision and available 3D model</li><li>Critical fits, datums and functional surfaces</li><li>Material, finish and treatment specifications</li><li>Required inspection records and acceptance criteria</li></ul><p>Capability, documentation and any application-specific requirements are confirmed per project.</p></div></div></section>

    <section class="section"><div class="container about-faq"><SectionHeading eyebrow="GETTING TO KNOW BELARO" title="A few practical questions"/><div class="faq-list">
      <details><summary>What types of customers are a good fit?</summary><p>Our focus is OEM manufacturers, industrial equipment builders and engineering businesses with drawing-based machining requirements, manageable batches and potential repeat demand. Share the part and project context so we can review suitability.</p></details>
      <details><summary>Are all processes carried out in-house?</summary><p>CNC machining is our core focus. Grinding, heat treatment, surface finishing and other secondary processes can be coordinated through suitable suppliers in Dongguan and Shenzhen. The operations and responsibilities included in an order are confirmed during quotation.</p></details>
      <details><summary>Can you support an additional or backup supply source?</summary><p>Send the drawing revision, material, quantity, inspection requirements and target delivery for review. An initial batch and any future repeat requirements can be discussed against the part and agreed production scope.</p></details>
      <details><summary>What should I send with my first enquiry?</summary><p>Provide your drawing, available 3D model, material grade, quantity and target delivery. Include critical tolerances, secondary process specifications and required documents. Use the RFQ form to share the project details and drawing attachment.</p></details>
    </div></div></section>

    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">WORK WITH BELARO</span><h2>Let’s talk about<br/><em>your next component.</em></h2><p>Share your drawing, material, quantity and project requirements. We’ll review the fit and clarify the next steps.</p></div><a class="button button-orange button-large" href="/contact/#rfq-form">Request a Quote <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:13px;color:#c7d1dd}.breadcrumbs a:hover{color:var(--orange)}
  .about-hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:65px;align-items:center}.about-hero h1{font-size:clamp(42px,5vw,64px)}.about-hero .hero-actions{flex-wrap:wrap;gap:20px}.company-profile{border:1px solid #40516a;border-top:3px solid var(--orange);padding:30px;background:var(--navy2)}.profile-label{font-size:11px;letter-spacing:2px;color:#c7d1dd}.company-profile h2{font-size:30px;line-height:1.25;margin:18px 0 24px;letter-spacing:-1px}.company-profile dl{margin:0 0 24px}.company-profile dl>div{border-top:1px solid #40516a;padding:13px 0}.company-profile dt{font-size:12px;color:#b8c4d1;margin-bottom:3px}.company-profile dd{font-size:15px;font-weight:600;margin:0}.company-profile>a{display:flex;justify-content:space-between;gap:15px;font-size:14px;font-weight:700}.company-profile>a span{color:var(--orange)}#our-approach,#working-together{scroll-margin-top:25px}
  .about-capabilities{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.about-capabilities article{border-top:3px solid var(--orange);background:#fff;padding:28px;display:flex;flex-direction:column;min-width:0}.about-capabilities .card-number{font-size:12px}.about-capabilities h3{font-size:24px;line-height:1.3;letter-spacing:-.7px;margin:18px 0 14px}.about-capabilities p{color:var(--muted);margin-bottom:24px}.about-capabilities .text-link{font-size:14px;margin-top:auto}.application-note{margin-top:30px;padding-top:24px;border-top:1px solid #cbd3dc;display:flex;align-items:center;justify-content:space-between;gap:30px}.application-note p{max-width:780px;color:var(--muted);margin:0}.application-note a{flex-shrink:0}
  .working-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 48px;list-style:none;padding:0;margin:0 0 30px}.working-steps li{display:flex;align-items:flex-start;gap:20px;border-top:1px solid #cbd3dc;padding-top:24px}.step-number{font:700 24px var(--display);color:var(--orange)}.working-steps h3{font-size:23px;line-height:1.3;letter-spacing:-.6px;margin:0 0 12px}.working-steps p{color:var(--muted);margin:0}.about-principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px}.about-principles article{border-top:2px solid var(--orange);padding-top:22px}.about-principles article>span{font-size:12px;letter-spacing:1px;color:#a74b19;font-weight:700}.about-principles h3{font-size:24px;line-height:1.3;letter-spacing:-.7px;margin:16px 0 14px}.about-principles p{color:var(--muted);margin:0}
  .about-quality{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:70px;align-items:center}.quality-review{border:1px solid #40516a;padding:30px}.quality-review h3{font-size:23px;letter-spacing:-.6px;margin:0 0 18px}.quality-review ul{padding-left:20px;margin:0 0 20px;color:#c7d1dd}.quality-review li{padding:5px 0}.quality-review li::marker{color:var(--orange)}.quality-review p{font-size:14px;margin:0;border-top:1px solid #40516a;padding-top:18px}.about-faq{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:70px}.faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer;padding-right:14px}.faq-list p{color:var(--muted);margin:15px 0 0}main a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:900px){.about-hero-grid{gap:30px}.company-profile{padding:24px}.about-capabilities{gap:16px}.about-capabilities article{padding:22px}.application-note{align-items:flex-start;flex-direction:column;gap:18px}.about-quality,.about-faq{gap:30px}}
  @media(max-width:700px){.breadcrumbs{margin-bottom:28px}.about-hero-grid,.about-capabilities,.working-steps,.about-principles,.about-quality,.about-faq{grid-template-columns:minmax(0,1fr)}.about-hero-grid{gap:38px}.about-hero h1{font-size:42px}.company-profile{padding:24px}.working-steps{gap:28px}.about-principles{gap:30px}.quality-review{padding:24px}.about-faq{gap:0}}
</style>

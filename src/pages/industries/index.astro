---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import SectionHeading from '../../components/SectionHeading.astro';
const sectors=[['automation','01','Industrial Automation','Components for motion systems, machine frames, fixtures and automated production equipment.'],['machinery','02','Industrial Machinery','Drawing-based machined parts used in machine assemblies, support structures and mechanical systems.'],['fluid','03','Hydraulic & Pneumatic Equipment','Potential component requirements for fluid-power systems, connectors, blocks and related equipment, subject to material and process review.'],['laboratory','04','Laboratory & Testing Equipment','Precision components for instruments, test rigs, fixtures and specialist equipment.']];
---
<BaseLayout title="Industries We Serve" description="Belaro Precision supports industrial automation, machinery, fluid power and laboratory equipment manufacturers with CNC machined components."><Header/><main><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">INDUSTRIES WE SERVE</span><h1>Industrial parts for<br/><em>real-world applications.</em></h1><p>We work with OEM teams that need machined components built to engineering drawings and project specifications.</p></div></section><section class="section"><div class="container"><SectionHeading eyebrow="SELECTED APPLICATIONS" title="Where precision components make a difference" text="These are target application areas, not claims of existing customer relationships. Every enquiry is assessed against actual manufacturing capability."/><div class="sector-list">{sectors.map(([id,n,title,desc])=><article class="sector-item" id={id}><span>{n}</span><div><h2>{title}</h2><p>{desc}</p></div><a href="/contact/" aria-label={`Enquire about ${title}`}>↗</a></article>)}</div></div></section><section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">YOUR APPLICATION</span><h2>Have a component<br/><em>in mind?</em></h2><p>Share the drawing, material and quantity. We’ll review whether the requirement is a fit.</p></div><a class="button button-orange button-large" href="/contact/">Send Your Drawing ↗</a></div></section></main><Footer/></BaseLayout>

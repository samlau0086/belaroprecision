---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PartIllustration from '../../components/PartIllustration.astro';
import SecondaryProcessSupport from '../../components/SecondaryProcessSupport.astro';
import { machinedParts, type MachinedPartId } from '../../data/machined-parts';

interface Sector {
  id: string;
  title: string;
  context: string;
  description: string;
  illustration: MachinedPartId;
  parts: MachinedPartId[];
  review: string[];
}

const sectors: Sector[] = [
  {
    id: 'automation', title: 'Industrial Automation', context: 'MOTION / POSITIONING / ASSEMBLY',
    description: 'Drawing-based components for automated equipment, positioning systems and assembly stations. Start with the interfaces that locate your tooling, sensors and moving assemblies.',
    illustration: 'mounting-brackets', parts: ['mounting-brackets', 'machined-blocks', 'precision-shafts'],
    review: ['Datum faces, locating holes and mounting patterns', 'Bearing fits, shaft shoulders and alignment requirements', 'Clearance for assembly, adjustment and tool access'],
  },
  {
    id: 'machinery', title: 'Industrial Machinery', context: 'SUPPORT / ROTATION / MECHANICAL INTERFACES',
    description: 'Custom parts for machine assemblies and mechanical equipment, from supporting plates to turned components. Define how each part fits, moves and connects within the assembly.',
    illustration: 'precision-shafts', parts: ['precision-shafts', 'bushings-sleeves', 'plates-housings'],
    review: ['Mating diameters, runout and shoulder positions', 'Flatness, perpendicularity and assembly datums', 'Wear surfaces, material condition and treatment needs'],
  },
  {
    id: 'fluid', title: 'Hydraulic & Pneumatic Equipment', context: 'BLOCKS / ADAPTERS / SEALING INTERFACES',
    description: 'Machined blocks, adapters and connecting components for fluid-power equipment, subject to drawing and process review. Identify the interfaces and acceptance criteria that matter to your system.',
    illustration: 'custom-connectors', parts: ['machined-blocks', 'custom-connectors', 'bushings-sleeves'],
    review: ['Port locations, thread standards and intersecting passages', 'Sealing faces, bore finish and edge requirements', 'Specified deburring, cleanliness and any pressure or leak testing'],
  },
  {
    id: 'laboratory', title: 'Laboratory & Testing Equipment', context: 'FIXTURES / INSTRUMENT MOUNTS / ENCLOSURES',
    description: 'Custom mechanical components for test rigs, laboratory fixtures and instrument assemblies. Share the locating features, mounting geometry and surface requirements that support your equipment design.',
    illustration: 'plates-housings', parts: ['plates-housings', 'mounting-brackets', 'machined-blocks'],
    review: ['Fixture datums, hole positions and repeatable assembly', 'Pocket geometry, wall thickness and component clearances', 'Functional versus cosmetic surfaces and finish callouts'],
  },
];

const capabilities = [
  { title: 'CNC Milling', text: '3-axis machining for accessible faces, pockets and hole patterns; simultaneous 5-axis machining for complex geometry, reviewed against your drawing.', href: '/services/cnc-milling/', label: 'Explore CNC Milling' },
  { title: 'CNC Turning', text: 'Shafts, sleeves, bushings and connectors reviewed around rotational features, mating diameters, threads and surface requirements.', href: '/services/cnc-turning/', label: 'Explore CNC Turning' },
  { title: 'OEM & Low-Volume Production', text: 'Initial batches and repeat requirements planned around the agreed drawing revision, inspection scope, quantity and delivery needs.', href: '/services/production/', label: 'Explore OEM production' },
];
---
<BaseLayout title="CNC Machined Components for Industrial OEM Applications" description="Explore CNC machined components for automation, industrial machinery, hydraulic and pneumatic equipment, and laboratory systems. Discuss your drawing with Belaro.">
  <Header />
  <main>
    <section class="page-hero industries-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Industries</span></nav>
        <span class="eyebrow eyebrow-light">INDUSTRIAL APPLICATIONS / OEM COMPONENTS</span>
        <h1>Your application.<br/><em>Our starting point.</em></h1>
        <p>Drawing-based CNC machined components for equipment builders and OEM teams. Connect your application to the part geometry, process route and inspection requirements that define it.</p>
        <div class="hero-actions"><a class="button button-orange" href="/contact/#rfq-form">Discuss Your Component <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#applications">Explore applications <span aria-hidden="true">↓</span></a></div>
      </div>
    </section>

    <section class="section" id="applications" aria-labelledby="applications-heading">
      <div class="container">
        <div class="industry-intro"><div><span class="eyebrow">WHERE YOUR PART FITS</span><h2 id="applications-heading">Different equipment.<br/><em>A drawing-led approach.</em></h2></div><p>These application areas help you identify relevant component types and requirements. They describe target applications, not existing customer relationships. Illustrations are conceptual part studies; every enquiry is assessed against actual manufacturing capability.</p></div>
        <nav class="industry-jumps" aria-label="Industrial applications">{sectors.map((sector, index) => <a href={`#${sector.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{sector.title}<span aria-hidden="true">↓</span></a>)}</nav>
        <div class="sector-details">
          {sectors.map((sector, index) => <article class="industry-detail" id={sector.id} aria-labelledby={`${sector.id}-heading`}>
            <div class="industry-visual"><span class="study-number">{String(index + 1).padStart(2, '0')} / APPLICATION STUDY</span><PartIllustration kind={sector.illustration} /><span class="illustration-caption">CONCEPT ILLUSTRATION</span></div>
            <div class="industry-copy"><span class="industry-context">{sector.context}</span><h3 id={`${sector.id}-heading`}>{sector.title}</h3><p>{sector.description}</p><h4>Typical component requirements</h4><div class="component-links">{sector.parts.map(id => <a href={`/machined-parts/#${id}`}>{machinedParts.find(part => part.id === id)!.title}<span aria-hidden="true">↗</span></a>)}</div><h4>What we review with your drawing</h4><ul>{sector.review.map(item => <li>{item}</li>)}</ul>{sector.id === 'fluid' && <p class="scope-note">Pressure rating, leak testing, cleanliness verification and system compliance are not assumed services. State the required standards and evidence so feasibility and scope can be confirmed before ordering.</p>}<a class="text-link" href="/contact/#rfq-form" aria-label={`Discuss your ${sector.title} component`}>Discuss your component <span aria-hidden="true">↗</span></a></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="section section-soft"><div class="container"><SectionHeading eyebrow="MATCH THE PROCESS TO THE PART" title="Capabilities behind your application" text="The process route follows the geometry, material and functional requirements. Explore the relevant capability, then share your drawing for review."/><div class="application-capabilities">{capabilities.map((capability, index) => <article><span class="card-number">0{index + 1} / CAPABILITY</span><h3>{capability.title}</h3><p>{capability.text}</p><a class="text-link" href={capability.href}>{capability.label}<span aria-hidden="true">→</span></a></article>)}</div></div></section>

    <SecondaryProcessSupport title="Consider the finished part, not just its geometry" text="Your application may call for grinding, heat treatment or surface finishing after machining. Based in Shenzhen, Belaro can coordinate these requirements through its supplier network in Dongguan and Shenzhen, with process specifications, final dimensions and requested records confirmed per project." />

    <section class="section section-soft"><div class="container"><SectionHeading eyebrow="FROM APPLICATION TO RFQ" title="Tell us what your component needs to do" text="A drawing defines the part. Application context helps identify the interfaces, checks and final condition that need particular attention."/><dl class="application-checklist"><div><dt>Drawing & revision</dt><dd>A dimensioned drawing and available 3D model, with the current revision clearly identified.</dd></div><div><dt>Function & mating parts</dt><dd>Where the part is used, how it assembles and which surfaces, holes or diameters are critical.</dd></div><div><dt>Material & final condition</dt><dd>Material grade, starting condition, treatment or finish specification, and any protected areas.</dd></div><div><dt>Inspection & acceptance</dt><dd>Critical tolerances, required records and any application-specific tests or standards for review.</dd></div><div><dt>Quantity & repeat demand</dt><dd>Initial batch quantity and expected repeat requirements, including any revision-control needs.</dd></div><div><dt>Delivery & project stage</dt><dd>Target delivery and whether the requirement is for equipment development, an initial build or repeat production.</dd></div></dl><div class="checklist-links"><a class="text-link" href="/quality/">Our quality approach <span aria-hidden="true">→</span></a><a class="text-link" href="/machined-parts/">Explore all part families <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section"><div class="container industries-faq"><SectionHeading eyebrow="BEFORE YOU ENQUIRE" title="Questions about your application"/><div class="faq-list">
      <details><summary>What if my industry is not listed?</summary><p>The sectors above are starting points rather than a complete list. Send your drawing, application context, material and quantity. We will assess whether the component and required process route are a fit.</p></details>
      <details><summary>Are the illustrated components available to order?</summary><p>The illustrations describe part families rather than stock products or completed customer projects. Components are quoted to your own drawings and agreed requirements.</p></details>
      <details><summary>Can you support initial batches and repeat OEM orders?</summary><p>Belaro focuses on drawing-based OEM and low-volume component requirements. Batch suitability, repeat-order arrangements and delivery are confirmed after reviewing the part, quantity and inspection scope.</p></details>
      <details><summary>Do you provide industry-specific certification or testing?</summary><p>This page does not establish sector-specific certification or regulatory approval. State any certification, traceability, cleanliness, pressure testing or other acceptance requirements in your RFQ. Availability and responsibility must be confirmed in the quotation.</p></details>
      <details><summary>Can machining and secondary processes be reviewed together?</summary><p>Yes. Include the complete requirements for grinding, heat treatment, surface finishing or other secondary processes. These can be reviewed through the Dongguan and Shenzhen supplier network, with the included operations and documentation agreed per project.</p></details>
    </div></div></section>

    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">LET’S REVIEW YOUR APPLICATION</span><h2>Start with the part<br/><em>your equipment needs.</em></h2><p>Send your drawing, material, quantity and application requirements. We’ll review the manufacturing route and clarify the next steps.</p></div><a class="button button-orange button-large" href="/contact/#rfq-form">Request a Quote <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:13px;color:#c7d1dd}.breadcrumbs a:hover{color:var(--orange)}
  .industries-hero p{max-width:730px}.industry-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:80px;align-items:end;margin-bottom:36px}.industry-intro h2{font-size:clamp(34px,4vw,48px);line-height:1.2;margin:15px 0 0}.industry-intro p{color:var(--muted);margin:0}
  .industry-jumps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:56px}.industry-jumps a{display:flex;align-items:center;gap:14px;border:1px solid var(--line);padding:15px 20px;font-size:14px;font-weight:600}.industry-jumps a:hover{border-color:var(--orange)}.industry-jumps span{color:var(--orange)}.industry-jumps span:last-child{margin-left:auto}
  .sector-details{display:grid;gap:56px}.industry-detail{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);border-top:1px solid var(--line);padding-top:42px;gap:50px;align-items:start;scroll-margin-top:30px}.industry-visual{background-color:var(--soft);background-image:linear-gradient(#e3e8ee80 1px,transparent 1px),linear-gradient(90deg,#e3e8ee80 1px,transparent 1px);background-size:28px 28px;padding:24px;color:#415d7b}.study-number,.illustration-caption{display:block;font-size:11px;letter-spacing:1.5px;color:var(--muted)}.industry-visual :global(svg){display:block;width:100%;height:auto;margin:20px 0}.illustration-caption{text-align:right;font-size:10px}.industry-context{color:#a74b19;font-size:11px;font-weight:700;letter-spacing:1px}.industry-copy h3{font-size:32px;letter-spacing:-1px;line-height:1.2;margin:12px 0 18px}.industry-copy p,.industry-copy ul{color:var(--muted)}.industry-copy h4{font-size:14px;margin:22px 0 12px}.component-links{display:flex;flex-wrap:wrap;gap:8px}.component-links a{display:inline-flex;align-items:center;gap:12px;background:var(--soft);border:1px solid var(--line);padding:6px 10px;font-size:13px}.component-links a:hover{border-color:var(--orange)}.component-links span{color:var(--orange)}.industry-copy ul{padding-left:20px;margin:0 0 22px}.industry-copy li{padding:3px 0}.industry-copy li::marker{color:var(--orange)}.industry-copy .scope-note{font-size:13px;border-left:2px solid var(--orange);padding-left:15px;margin-bottom:22px}
  .application-capabilities{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.application-capabilities article{background:#fff;border-top:3px solid var(--orange);padding:28px;display:flex;flex-direction:column;min-width:0}.application-capabilities .card-number{font-size:12px}.application-capabilities h3{font-size:24px;line-height:1.3;margin:18px 0 14px;letter-spacing:-.7px}.application-capabilities p{color:var(--muted);margin-bottom:24px}.application-capabilities .text-link{font-size:14px;margin-top:auto}
  .application-checklist{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:55px;margin:0}.application-checklist>div{border-top:1px solid #cbd3dc;padding:22px 0}.application-checklist dt{font-weight:700;margin-bottom:8px}.application-checklist dd{margin:0;color:var(--muted)}.checklist-links{display:flex;flex-wrap:wrap;gap:20px 35px;margin-top:25px}.industries-faq{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:70px}.faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer;padding-right:14px}.faq-list p{color:var(--muted);margin:15px 0 0}
  main a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:900px){.industry-intro{gap:35px}.industry-detail{gap:30px}.application-capabilities{gap:16px}.application-capabilities article{padding:22px}.industries-faq{gap:30px}}
  @media(max-width:700px){.breadcrumbs{margin-bottom:28px}.industry-intro,.industry-jumps,.industry-detail,.application-capabilities,.application-checklist,.industries-faq{grid-template-columns:minmax(0,1fr)}.industry-intro{gap:20px}.industry-intro h2{font-size:34px}.industry-jumps a{padding:12px 14px;gap:10px}.industry-detail{gap:25px;padding-top:28px}.sector-details{gap:40px}.industry-copy h3{font-size:28px}.industry-visual :global(svg){max-height:210px}.industries-faq{gap:0}}
</style>

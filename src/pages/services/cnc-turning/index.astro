---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import SecondaryProcessSupport from '../../../components/SecondaryProcessSupport.astro';
import ProcessImage from '../../../components/ProcessImage.astro';
import { machinedParts } from '../../../data/machined-parts';

const turningParts = machinedParts.filter(part => part.process === 'CNC Turning');
const quoteUrl = '/contact/?process=turning#rfq-form';
const reviewItems = [
  { title: 'Diameter fits & shoulders', text: 'Mark bearing seats, mating diameters, shoulders and the dimensions that control assembly or movement.' },
  { title: 'Runout & concentricity', text: 'Identify rotating features, datum references and any runout or concentricity requirements that affect function.' },
  { title: 'Threads & interfaces', text: 'Specify thread standards, internal or external threads, chamfers and the interfaces that must mate with other parts.' },
  { title: 'Quantity & repeat orders', text: 'Provide the initial quantity, target delivery and expected repeat demand so the production route can be reviewed.' },
];
---
<BaseLayout title="CNC Turning Services for Custom OEM Parts" description="Drawing-based CNC turning for OEM shafts, bushings, sleeves and connectors. Share your material, tolerances and batch requirements with Belaro Precision.">
  <Header /><main>
    <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Capabilities</a><span aria-hidden="true">/</span><span aria-current="page">CNC Turning</span></nav><div class="turning-hero-grid"><div><span class="eyebrow eyebrow-light">CNC TURNING / OEM COMPONENTS</span><h1>Rotational parts.<br/><em>Made to your drawing.</em></h1><p>Drawing-based turning for shafts, bushings, sleeves and connectors used in industrial assemblies. Start with the dimensions and interfaces that control fit.</p><div class="turning-actions"><a class="button button-orange" href={quoteUrl}>Request a Turning Quote <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#turned-parts">Explore turned parts <span aria-hidden="true">↓</span></a></div></div><ProcessImage loading="eager" name="turning-process-detail" alt="CNC turning tool machining a stepped shaft" width={1586} height={992} /></div></div></section>
    <section class="section" id="turned-parts"><div class="container"><div class="turning-intro"><div><span class="eyebrow">PARTS WITH A PURPOSE</span><h2>From bearing seats<br/><em>to fitted interfaces.</em></h2></div><p>Explore typical turned part families for industrial OEM applications. These representative images describe component types; suitability is assessed against your drawing and actual process capability.</p></div><div class="turned-parts-grid">{turningParts.map(part => <article class="turned-part"><div class="turned-part-visual"><img src={`/images/machined-parts/${part.image}`} alt={`Representative ${part.title.toLowerCase()} CNC turned part`} loading="lazy" decoding="async"/><span>REPRESENTATIVE PART</span></div><div class="turned-part-copy"><h3>{part.title}</h3><p>{part.description}</p><a class="text-link" href={`/machined-parts/#${part.id}`}>Explore this part family <span aria-hidden="true">→</span></a></div></article>)}</div></div></section>
    <section class="section section-soft" id="drawing-review"><div class="container"><SectionHeading eyebrow="ENGINEERING REQUIREMENTS" title="A useful quote starts with the right details" text="A rotational profile alone does not define a production component. Include the requirements that control fit, function and inspection."/><div class="turning-review-grid">{reviewItems.map((item, index) => <article><span>0{index + 1} / REVIEW</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="turning-note"><strong>Confirm capability against your drawing.</strong><p>Diameter, length, geometry, material, tolerances, inspection documents and lead time are reviewed per project. This page does not specify guaranteed machining limits or a universal tolerance.</p><a class="text-link" href="/quality/">Our quality approach <span aria-hidden="true">→</span></a></div></div></section>
    <section class="section"><div class="container turning-specs"><SectionHeading eyebrow="MATERIAL & FINISH" title="Specify the result your component needs" text="Tell us what the part is made from and how its functional surfaces must perform. Material availability and finishing scope are confirmed in the quotation."/><dl class="spec-list"><div><dt>Material specification</dt><dd>Exact grade or standard, temper or condition, and any material documentation required.</dd></div><div><dt>Functional surfaces</dt><dd>Bearing seats, mating diameters, fits, edge breaks and surface finish callouts.</dd></div><div><dt>Threads and treatment</dt><dd>Thread standard, coating or treatment specification, masking areas and dimensions to verify after finishing.</dd></div><div><dt>Inspection records</dt><dd>Critical characteristics, measurement criteria and requested inspection documentation.</dd></div></dl></div></section>
    <SecondaryProcessSupport soft title="Complete the route beyond turning" text="Where turned components also require grinding, heat treatment or surface finishing, Belaro can coordinate the specified secondary process through its Dongguan and Shenzhen supplier network." />
    <section class="section"><div class="container"><SectionHeading eyebrow="FROM RFQ TO PRODUCTION" title="Align the requirements before cutting begins"/><ol class="turning-steps"><li><span>01</span><h3>Share the drawing</h3><p>Send a dimensioned PDF, a 3D model if available, material grade, quantity and target delivery.</p></li><li><span>02</span><h3>Review the details</h3><p>Clarify critical diameters, threads, inspection needs, feasibility and commercial scope.</p></li><li><span>03</span><h3>Confirm the order</h3><p>Agree the drawing revision, specifications, quantity and delivery arrangements before production.</p></li></ol><a class="text-link" href="/services/#production">Low-volume production approach <span aria-hidden="true">→</span></a></div></section>
    <section class="section"><div class="container turning-faq"><SectionHeading eyebrow="BEFORE YOU ENQUIRE" title="CNC turning questions"/><div class="turning-faq-list"><details><summary>What files should I send for a turning quote?</summary><p>A dimensioned PDF drawing and, where available, a STEP model are a useful starting point. Include the revision, material grade, quantity, critical fits and target delivery. Related files can be packaged in a ZIP.</p></details><details><summary>Can you review shafts, sleeves and bushings?</summary><p>Yes, enquiries can be reviewed for rotational components such as stepped shafts, sleeves, bushings and adapters. Suitability depends on the drawing and agreed requirements.</p></details><details><summary>What should I specify for a bearing seat?</summary><p>Include the diameter, tolerance or fit, surface finish, datum reference and any runout or concentricity requirement. Final feasibility is confirmed during quotation.</p></details><details><summary>Can you produce threaded components?</summary><p>List the thread standard, size, class or fit and whether the feature is internal or external. Thread scope and inspection requirements are reviewed per project.</p></details><details><summary>What if my component needs both turning and milling?</summary><p>Send the complete drawing and describe the critical interfaces. Select “Not sure — please review” in the RFQ form if the required process is unclear.</p></details></div></div></section>
    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">YOUR NEXT TURNED COMPONENT</span><h2>Let’s review<br/><em>your drawing.</em></h2><p>Share the component, material and batch requirements. Start a focused conversation about your turning project.</p></div><a class="button button-orange button-large" href={quoteUrl}>Request a Turning Quote <span aria-hidden="true">↗</span></a></div></section>
  </main><Footer />
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:16px;color:#c7d1dd}.breadcrumbs a:hover{color:var(--orange)}
  .turning-hero-grid :global(.process-image){border:1px solid #40516a;background:#14263e}.turning-hero-grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:50px}.turning-hero h1{font-size:clamp(38px,4.6vw,62px)}.turning-actions{display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-top:28px}.turning-actions .button{gap:14px}
  .turning-study{min-width:0;border:1px solid #40516a;background:linear-gradient(135deg,#223a57,#14263e);padding:26px;color:#506b88}.turning-study>span,.turning-study>p{font-size:16px;letter-spacing:1px;color:#bdccdb}.turning-study :global(svg){width:100%;height:auto;display:block}.turning-study>p{margin:0 0 18px;letter-spacing:0}.study-tags{display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #40516a;padding-top:18px}.study-tags span{color:#d3dce6;font-size:16px;border:1px solid #40516a;padding:4px 8px}
  .turning-intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:60px;margin-bottom:38px}.turning-intro h2{font-size:clamp(32px,4vw,44px);line-height:1.2;margin:15px 0 0}.turning-intro>p{color:var(--muted);margin:0}.turned-parts-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.turned-part{border:1px solid var(--line);display:flex;flex-direction:column;min-width:0}.turned-part-visual{background:var(--soft);padding:20px;color:#415d7b}.turned-part-visual img{display:block;width:100%;height:185px;object-fit:cover;margin-bottom:12px}.turned-part-visual span{font-size:16px;color:var(--muted);letter-spacing:1px}.turned-part-copy{padding:24px;display:flex;flex-direction:column;flex:1}.turned-part h3{font-size:23px;letter-spacing:-.6px;margin-bottom:12px}.turned-part p{color:var(--muted)}.turned-part .text-link{margin-top:auto;font-size:16px}
  .turning-review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.turning-review-grid article{padding:28px;background:#fff;border-top:2px solid var(--orange)}.turning-review-grid article>span{color:#a74b19;font-size:16px;letter-spacing:1px}.turning-review-grid h3{font-size:24px;letter-spacing:-.6px;margin:16px 0 12px}.turning-review-grid p{color:var(--muted);margin-bottom:0}.turning-note{border-left:3px solid var(--orange);padding:22px 26px;background:#fff;margin-top:30px}.turning-note p{color:var(--muted);margin:8px 0 14px}
  .turning-specs,.turning-faq{display:grid;grid-template-columns:1fr 1.2fr;gap:65px}.spec-list{margin:0}.spec-list>div{padding:20px 0;border-top:1px solid var(--line)}.spec-list dt{font-weight:700;margin-bottom:8px}.spec-list dd{margin:0;color:var(--muted)}.turning-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;padding:0;margin:0 0 24px}.turning-steps li{border-top:2px solid var(--orange);padding-top:22px}.turning-steps span{color:#a74b19;font-weight:700}.turning-steps h3{font-size:23px;letter-spacing:-.6px;margin:16px 0 12px}.turning-steps p{color:var(--muted)}
  .turning-faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.turning-faq-list details:first-child{border-top:1px solid var(--line)}.turning-faq-list summary{cursor:pointer;font-weight:600;padding-right:12px}.turning-faq-list p{color:var(--muted);margin:15px 0 0}.turning-hero a:focus-visible,.turned-part a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}#turned-parts,#drawing-review{scroll-margin-top:24px}
  @media(max-width:1000px){.turning-hero-grid,.turning-intro,.turning-specs,.turning-faq{gap:30px}.turned-part-copy{padding:20px}.turned-parts-grid{gap:16px}}
  @media(max-width:700px){.turning-hero-grid,.turning-intro,.turned-parts-grid,.turning-review-grid,.turning-specs,.turning-steps,.turning-faq{grid-template-columns:minmax(0,1fr)}.turning-hero h1{font-size:clamp(36px,8.7vw,48px)}.turning-study{padding:20px}.turning-study :global(svg){max-height:230px}.breadcrumbs{margin-bottom:28px}.turning-review-grid article{padding:24px}.turning-note{padding:20px}.turning-faq,.turning-specs{gap:0}.turned-part-visual img{height:230px}.turning-actions{gap:18px}}
</style>

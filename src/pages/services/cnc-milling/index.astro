---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import PartIllustration from '../../../components/PartIllustration.astro';
import SecondaryProcessSupport from '../../../components/SecondaryProcessSupport.astro';
import { machinedParts } from '../../../data/machined-parts';

const millingParts = machinedParts.filter(part => part.process === 'CNC Milling');
const quoteUrl = '/contact/?process=milling#rfq-form';
const reviewItems = [
  { title: 'Geometry & tool access', text: 'Share pockets, slots, internal corners, hole depths and thin-wall features so machining access and setup requirements can be reviewed.' },
  { title: 'Datums & critical dimensions', text: 'Identify locating faces, mating features and the tolerances that affect assembly. Include the drawing revision and inspection requirements.' },
  { title: 'Material & surface condition', text: 'Specify the exact material grade, any surface treatment and functional or cosmetic faces. These requirements are confirmed during quotation.' },
  { title: 'Quantity & repeat orders', text: 'Provide the initial quantity, target delivery and expected repeat demand to support a practical production review.' },
];
---
<BaseLayout title="CNC Milling Services for Custom OEM Parts" description="Drawing-based 3-axis, 3+2 positional and simultaneous 5-axis CNC milling for OEM brackets, blocks, plates and housings. Share your material, tolerances and batch requirements with Belaro Precision.">
  <Header />
  <main>
    <section class="page-hero milling-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Capabilities</a><span aria-hidden="true">/</span><span aria-current="page">CNC Milling</span></nav>
        <div class="milling-hero-grid">
          <div><span class="eyebrow eyebrow-light">CNC MILLING / OEM COMPONENTS</span><h1>Complex profiles.<br/><em>Made to your drawing.</em></h1><p>Drawing-based 3-axis, 3+2 positional and simultaneous 5-axis milling for brackets, blocks, plates and housings in industrial equipment. Start with the features that matter to your assembly.</p><div class="milling-actions"><a class="button button-orange" href={quoteUrl}>Request a Milling Quote <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#milled-parts">Explore milled parts <span aria-hidden="true">↓</span></a></div></div>
          <div class="milling-study"><span>GEOMETRY STUDY / MACHINED BLOCK</span><PartIllustration kind="machined-blocks"/><p>Concept illustration · Not a customer project</p><div class="study-tags"><span>Datum faces</span><span>Pockets & bores</span><span>Mounting features</span></div></div>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="milling-configurations" aria-labelledby="milling-configurations-heading">
      <div class="container">
        <div class="milling-intro"><div><span class="eyebrow">MILLING CONFIGURATIONS</span><h2 id="milling-configurations-heading">Choose the access<br/><em>your geometry needs.</em></h2></div><p>Belaro offers 3-axis, 3+2 positional and simultaneous 5-axis milling, with the process route reviewed against the drawing, material, tolerances and critical features.</p></div>
        <div class="milling-config-grid">
          <article id="three-axis"><span class="config-index">01 / 3-AXIS</span><h3>3-Axis CNC Machining</h3><p>Reliable 3-axis milling for plates, blocks, brackets, housings and components with accessible prismatic features.</p><a class="text-link" href={quoteUrl}>Discuss a 3-axis part <span aria-hidden="true">→</span></a></article>
          <article id="three-plus-two"><span class="config-index">02 / 3+2 POSITIONAL</span><h3>3+2 CNC Milling</h3><p>Also called positional 5-axis milling: two rotary axes position the part or tool at a fixed angle, then remain stationary during 3-axis cutting. Suitable for angled holes, inclined faces and pockets on multiple sides, subject to tool access and fixture review.</p><a class="text-link" href={quoteUrl}>Discuss a 3+2 part <span aria-hidden="true">→</span></a></article>
          <article id="five-axis"><span class="config-index">03 / SIMULTANEOUS 5-AXIS</span><h3>5-Axis CNC Machining</h3><p>Simultaneous 5-axis machining for complex surfaces, angled features and geometries that benefit from multi-directional tool access.</p><a class="text-link" href={quoteUrl}>Discuss a 5-axis part <span aria-hidden="true">→</span></a></article>
        </div>
      </div>
    </section>

    <section class="section" id="milled-parts" aria-labelledby="milled-parts-heading">
      <div class="container">
        <div class="milling-intro"><div><span class="eyebrow">PARTS WITH A PURPOSE</span><h2 id="milled-parts-heading">From mounting faces<br/><em>to assembly interfaces.</em></h2></div><p>Explore typical milled part families for industrial OEM applications. These illustrations describe component types; suitability is assessed against your drawing and actual process capability.</p></div>
        <div class="milled-parts-grid">{millingParts.map(part => <article class="milled-part"><div class="milled-part-visual"><PartIllustration kind={part.id}/><span>CONCEPT ILLUSTRATION</span></div><div class="milled-part-copy"><h3>{part.title}</h3><p>{part.description}</p><a class="text-link" href={`/machined-parts/#${part.id}`}>Explore this part family <span aria-hidden="true">→</span></a></div></article>)}</div>
      </div>
    </section>

    <section class="section section-soft" id="drawing-review"><div class="container"><SectionHeading eyebrow="ENGINEERING REQUIREMENTS" title="A useful quote starts with the right details" text="A 3D shape alone does not define a production component. Include the requirements that control fit, function and inspection."/><div class="milling-review-grid">{reviewItems.map((item, index) => <article><span>0{index + 1} / REVIEW</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="milling-note"><strong>Confirm capability against your drawing.</strong><p>Part size, geometry, material, tolerances, inspection documents and lead time are reviewed per project. This page does not specify guaranteed machining limits or a universal tolerance.</p><a class="text-link" href="/quality/">Our quality approach <span aria-hidden="true">→</span></a></div></div></section>

    <section class="section"><div class="container milling-specs"><SectionHeading eyebrow="MATERIAL & FINISH" title="Specify the result your component needs" text="Tell us what the part is made from and how its surfaces must perform. Material availability and any finishing scope are confirmed in the quotation."/><dl class="spec-list"><div><dt>Material specification</dt><dd>Exact grade or standard, temper or condition, and any material documentation required.</dd></div><div><dt>Functional surfaces</dt><dd>Surface finish callouts, mating faces, fits, edge breaks and burr requirements.</dd></div><div><dt>Surface treatment</dt><dd>Required coating or treatment specification, masking areas and dimensions to verify after finishing.</dd></div><div><dt>Inspection records</dt><dd>Critical characteristics, measurement criteria and requested inspection documentation.</dd></div></dl></div></section>
    <SecondaryProcessSupport soft title="Complete the route beyond milling" text="Grinding, heat treatment and surface finishing can be coordinated through Belaro's Dongguan and Shenzhen supplier network when they form part of the drawing requirement. Scope and inspection are confirmed per project." />

    <section class="section"><div class="container"><SectionHeading eyebrow="FROM RFQ TO PRODUCTION" title="Align the requirements before cutting begins"/><ol class="milling-steps"><li><span>01</span><h3>Share the drawing</h3><p>Send a dimensioned PDF, a 3D model if available, material grade, quantity and target delivery.</p></li><li><span>02</span><h3>Review the details</h3><p>Clarify critical features, machining feasibility, inspection needs and commercial scope.</p></li><li><span>03</span><h3>Confirm the order</h3><p>Agree the drawing revision, specifications, quantity and delivery arrangements before production.</p></li></ol><a class="text-link" href="/services/#production">Low-volume production approach <span aria-hidden="true">→</span></a></div></section>

    <section class="section"><div class="container milling-faq"><SectionHeading eyebrow="BEFORE YOU ENQUIRE" title="CNC milling questions"/><div class="milling-faq-list">
      <details><summary>How does 3+2 milling differ from simultaneous 5-axis milling?</summary><p>In 3+2 milling, the rotary axes position the part or tool before each cut and remain stationary while the three linear axes cut the feature. Simultaneous 5-axis milling coordinates linear and rotary motion during cutting. Belaro supports both methods and reviews geometry, tool access, fixturing and critical dimensions to select the route for your part.</p></details>
      <details><summary>What files should I send for a milling quote?</summary><p>A dimensioned PDF drawing and, where available, a STEP model are a useful starting point. Include the revision, material grade, quantity, critical tolerances and target delivery. The RFQ form accepts a single attachment; related files can be packaged in a ZIP.</p></details>
      <details><summary>Can you review low-volume and repeat production?</summary><p>Yes, enquiries can be reviewed for low-volume OEM batches and repeat orders. Quantity suitability, production arrangements and delivery depend on the part and the agreed requirements.</p></details>
      <details><summary>What tolerances can you achieve?</summary><p>Share the required tolerances and datums on your drawing. Feasibility depends on the feature, geometry, material, setup and inspection conditions. Final tolerances must be confirmed during quotation.</p></details>
      <details><summary>Are material and surface treatments included?</summary><p>List the exact material grade and any finish or treatment specification in your enquiry. Availability, process suitability, documentation and the scope of supply are confirmed per project.</p></details>
      <details><summary>What if my component needs both milling and turning?</summary><p>Send the complete drawing and describe the critical interfaces. Select “Not sure — please review” in the RFQ form if the required process is unclear. Any combined process route must be reviewed before quotation.</p></details>
    </div></div></section>

    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">YOUR NEXT MILLED COMPONENT</span><h2>Let’s review<br/><em>your drawing.</em></h2><p>Share the component, material and batch requirements. Start a focused conversation about your milling project.</p></div><a class="button button-orange button-large" href={quoteUrl}>Request a Milling Quote <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:13px;color:#c7d1dd}.breadcrumbs a:hover{color:var(--orange)}
  .milling-hero-grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:50px}.milling-hero h1{font-size:clamp(38px,4.6vw,62px)}.milling-actions{display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-top:28px}.milling-actions .button{gap:14px}
  .milling-study{min-width:0;border:1px solid #40516a;background:linear-gradient(135deg,#223a57,#14263e);padding:26px;color:#506b88}.milling-study>span,.milling-study>p{font-size:11px;letter-spacing:1px;color:#bdccdb}.milling-study :global(svg){width:100%;height:auto;display:block}.milling-study>p{margin:0 0 18px;letter-spacing:0}.study-tags{display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #40516a;padding-top:18px}.study-tags span{color:#d3dce6;font-size:11px;border:1px solid #40516a;padding:4px 8px}
  .milling-intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:60px;margin-bottom:38px}.milling-intro h2{font-size:clamp(32px,4vw,44px);line-height:1.2;margin:15px 0 0}.milling-intro>p{color:var(--muted);margin:0}.milled-parts-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.milled-part{border:1px solid var(--line);display:flex;flex-direction:column;min-width:0}.milled-part-visual{background:var(--soft);padding:20px;color:#415d7b}.milled-part-visual :global(svg){display:block;width:100%;height:185px}.milled-part-visual span{font-size:10px;color:var(--muted);letter-spacing:1px}.milled-part-copy{padding:24px;display:flex;flex-direction:column;flex:1}.milled-part h3{font-size:23px;letter-spacing:-.6px;margin-bottom:12px}.milled-part p{color:var(--muted)}.milled-part .text-link{margin-top:auto;font-size:14px}
  .milling-config-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.milling-config-grid article{display:flex;flex-direction:column;padding:28px;background:#fff;border:1px solid var(--line);min-height:230px}.config-index{color:#a74b19;font-size:12px;letter-spacing:1px}.milling-config-grid h3{font-size:25px;letter-spacing:-.6px;margin:18px 0 12px}.milling-config-grid p{color:var(--muted);margin:0 0 22px}.milling-config-grid .text-link{margin-top:auto}
  .milling-review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.milling-review-grid article{padding:28px;background:#fff;border-top:2px solid var(--orange)}.milling-review-grid article>span{color:#a74b19;font-size:12px;letter-spacing:1px}.milling-review-grid h3{font-size:24px;letter-spacing:-.6px;margin:16px 0 12px}.milling-review-grid p{color:var(--muted);margin-bottom:0}.milling-note{border-left:3px solid var(--orange);padding:22px 26px;background:#fff;margin-top:30px}.milling-note p{color:var(--muted);margin:8px 0 14px}
  .milling-specs,.milling-faq{display:grid;grid-template-columns:1fr 1.2fr;gap:65px}.spec-list{margin:0}.spec-list>div{padding:20px 0;border-top:1px solid var(--line)}.spec-list dt{font-weight:700;margin-bottom:8px}.spec-list dd{margin:0;color:var(--muted)}.milling-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;padding:0;margin:0 0 24px}.milling-steps li{border-top:2px solid var(--orange);padding-top:22px}.milling-steps span{color:#a74b19;font-weight:700}.milling-steps h3{font-size:23px;letter-spacing:-.6px;margin:16px 0 12px}.milling-steps p{color:var(--muted)}
  .milling-faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.milling-faq-list details:first-child{border-top:1px solid var(--line)}.milling-faq-list summary{cursor:pointer;font-weight:600;padding-right:12px}.milling-faq-list p{color:var(--muted);margin:15px 0 0}.milling-hero a:focus-visible,.milled-part a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}#milled-parts,#drawing-review{scroll-margin-top:24px}
  @media(min-width:701px) and (max-width:1000px){.milling-config-grid{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:1000px){.milling-hero-grid,.milling-intro,.milling-specs,.milling-faq{gap:30px}.milled-part-copy{padding:20px}.milled-parts-grid{gap:16px}}
  @media(max-width:700px){.milling-hero-grid,.milling-intro,.milled-parts-grid,.milling-config-grid,.milling-review-grid,.milling-specs,.milling-steps,.milling-faq{grid-template-columns:minmax(0,1fr)}.milling-hero h1{font-size:clamp(36px,8.7vw,48px)}.milling-study{padding:20px}.milling-study :global(svg){max-height:230px}.breadcrumbs{margin-bottom:28px}.milling-review-grid article{padding:24px}.milling-config-grid article{min-height:0;padding:24px}.milling-note{padding:20px}.milling-faq,.milling-specs{gap:0}.milled-part-visual :global(svg){height:210px}.milling-actions{gap:18px}}
</style>

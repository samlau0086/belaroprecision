---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import SecondaryProcessSupport from '../../../components/SecondaryProcessSupport.astro';
import ProcessImage from '../../../components/ProcessImage.astro';
---
<BaseLayout title="OEM & Low-Volume Production Support" description="Production-focused CNC machining support for OEM components, low-volume batches and repeat orders. Align drawings, requirements and delivery with Belaro Precision.">
  <Header /><main>
    <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Capabilities</a><span aria-hidden="true">/</span><span aria-current="page">OEM & Low-Volume Production</span></nav><div class="production-hero-grid"><div><span class="eyebrow eyebrow-light">OEM PRODUCTION / LOW VOLUME</span><h1>From first-off parts<br/><em>to repeat orders.</em></h1><p>Production-minded support for OEM components where drawing control, clear communication and repeatability matter.</p><div class="production-actions"><a class="button button-orange" href="/contact/#rfq-form">Discuss your project <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#production-flow">Explore the process <span aria-hidden="true">↓</span></a></div></div><ProcessImage loading="eager" name="production-oem" alt="Organized batches of machined components prepared for OEM production and packing" width={1586} height={992} /></div></div></section>
    <section class="section"><div class="container production-intro"><SectionHeading eyebrow="A PRACTICAL PRODUCTION MODEL" title="Built around the way OEM teams work" text="The right production route depends on part complexity, material, quantity and the requirements in your drawing. We align those details before making a production commitment."/><div class="production-principles"><article><span>01</span><h3>Drawing control</h3><p>Keep revision, specifications and inspection requirements clear from enquiry through repeat order.</p></article><article><span>02</span><h3>Commercial clarity</h3><p>Review quantity, delivery expectations and scope so the quotation reflects the actual requirement.</p></article><article><span>03</span><h3>Repeatability</h3><p>Retain the agreed part requirements and communicate changes before a repeat production run.</p></article></div></div></section>
    <section class="section section-soft" id="production-flow"><div class="container"><SectionHeading eyebrow="FROM RFQ TO REPEAT ORDER" title="A clear path through production"/><ol class="production-steps"><li><span>01</span><h3>Share the requirement</h3><p>Send drawings, models, material, quantity forecast and target delivery information.</p></li><li><span>02</span><h3>Review feasibility</h3><p>Clarify critical features, inspection needs, finish, packaging and commercial scope.</p></li><li><span>03</span><h3>Approve the order</h3><p>Confirm revision, quantity, specifications and delivery arrangements before production.</p></li><li><span>04</span><h3>Manage repeats</h3><p>Reference the agreed requirements and communicate any drawing or quantity changes.</p></li></ol></div></section>
    <section class="section"><div class="container production-scope"><SectionHeading eyebrow="WHAT TO INCLUDE" title="Help us review the whole requirement" text="A useful RFQ includes more than a part file. These details help define a workable production conversation."/><dl class="scope-list"><div><dt>Part documentation</dt><dd>Dimensioned PDF, 3D model where available, drawing revision and critical characteristics.</dd></div><div><dt>Quantity profile</dt><dd>Initial batch, annual demand, expected repeat frequency and any forecast changes.</dd></div><div><dt>Quality requirements</dt><dd>Material certificates, inspection records, first article needs and traceability expectations.</dd></div><div><dt>Delivery and packing</dt><dd>Target delivery, destination, packaging requirements and any shipment instructions.</dd></div></dl></div></section>
    <SecondaryProcessSupport soft title="Coordinate the complete production route" text="Repeat OEM parts may require grinding, heat treatment or surface finishing after CNC machining. Belaro can coordinate these steps through its Dongguan and Shenzhen supplier network, with the route and records agreed for the order." />
    <section class="section"><div class="container production-faq"><SectionHeading eyebrow="BEFORE YOU ENQUIRE" title="Production questions"/><div class="production-faq-list"><details><summary>What batch sizes can you review?</summary><p>We can review low-volume and repeat OEM requirements. Quantity suitability, production arrangements and delivery depend on the component and agreed specifications.</p></details><details><summary>Can you support repeat orders?</summary><p>Yes. Repeat work is reviewed against the agreed drawing revision, material, inspection requirements and any changes communicated before production.</p></details><details><summary>Do you offer an automatic blanket order?</summary><p>Commercial arrangements are project-specific. Include your expected demand and delivery pattern so the appropriate approach can be discussed.</p></details><details><summary>Can you inspect and provide records?</summary><p>List the critical characteristics and requested documents in your enquiry. Inspection scope and records are confirmed per project.</p></details><details><summary>What if I am unsure which process is needed?</summary><p>Send the complete drawing and select “Not sure — please review” in the RFQ form. The required process route must be reviewed before quotation.</p></details></div></div></section>
    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">READY TO DISCUSS PRODUCTION?</span><h2>Share your next<br/><em>OEM requirement.</em></h2><p>Send the drawing, quantity profile and delivery expectations. We will review the requirement and respond with the next steps.</p></div><a class="button button-orange button-large" href="/contact/#rfq-form">Discuss your project <span aria-hidden="true">↗</span></a></div></section>
  </main><Footer />
</BaseLayout>

<style>
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:38px;font-size:16px;color:#c7d1dd}.breadcrumbs a:hover{color:var(--orange)}
  .production-hero-grid :global(.process-image){border:1px solid #40516a;background:#14263e}.production-hero-grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:50px}.production-hero-grid h1{font-size:clamp(38px,4.6vw,62px)}.production-actions{display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-top:28px}.production-study{border:1px solid #40516a;background:linear-gradient(135deg,#223a57,#14263e);padding:26px;color:#bdccdb}.production-study>span{font-size:16px;letter-spacing:1px}.production-study>p{font-size:16px;color:#bdccdb;margin:22px 0 0}.study-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px}.study-grid>div{min-height:150px;padding:16px 12px;border:1px solid #40516a;display:flex;flex-direction:column;justify-content:space-between}.study-grid b{color:var(--orange);font-size:16px}.study-grid strong{font:700 19px var(--display);color:#fff}.study-grid small{font-size:16px;color:#bdccdb}
  .production-intro,.production-scope,.production-faq{display:grid;grid-template-columns:1fr 1.2fr;gap:65px}.production-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.production-principles article{border-top:2px solid var(--orange);padding:20px 0}.production-principles span,.production-steps span{color:#a74b19;font-weight:700}.production-principles h3{font-size:22px;margin:20px 0 10px}.production-principles p,.production-steps p{color:var(--muted)}
  .production-steps{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:0;margin:0}.production-steps li{background:#fff;border-top:2px solid var(--orange);padding:24px;min-width:0}.production-steps h3{font-size:20px;margin:20px 0 10px}.scope-list{margin:0}.scope-list>div{padding:20px 0;border-top:1px solid var(--line)}.scope-list dt{font-weight:700;margin-bottom:8px}.scope-list dd{margin:0;color:var(--muted)}.production-faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.production-faq-list details:first-child{border-top:1px solid var(--line)}.production-faq-list summary{cursor:pointer;font-weight:600}.production-faq-list p{color:var(--muted);margin:15px 0 0}
  .production-hero a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}#production-flow{scroll-margin-top:24px}
  @media(max-width:1000px){.production-hero-grid,.production-intro,.production-scope,.production-faq{gap:30px}.production-principles{grid-template-columns:1fr}.production-steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:700px){.production-hero-grid,.production-intro,.production-scope,.production-faq,.production-steps{grid-template-columns:minmax(0,1fr)}.production-hero-grid h1{font-size:clamp(36px,8.7vw,48px)}.production-study{padding:20px}.study-grid>div{min-height:125px}.breadcrumbs{margin-bottom:28px}.production-faq,.production-scope{gap:0}}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<BaseLayout title="Precision CNC Machining for OEM Manufacturers" description="Belaro Precision manufactures drawing-based CNC machined components for industrial machinery, automation systems and OEM applications.">
  <Header />
  <main>
    <section class="hero">
      <div class="hero-image"></div><div class="hero-shade"></div>
      <div class="container hero-content"><span class="eyebrow eyebrow-light"><i></i> CNC MACHINING FOR INDUSTRIAL OEMS</span><h1>Precision CNC Machining<br/><em>for OEM Manufacturers.</em></h1><p>Drawing-based machined components for industrial machinery, automation systems and demanding production applications.</p><div class="hero-actions"><a class="button button-orange" href="/contact/">Request a Quote <span>↗</span></a><a class="text-link text-link-light" href="/services/">Explore capabilities <span>→</span></a></div><div class="hero-proof"><div><strong>±0.01–0.02 mm</strong><small>Typical capability, subject to part review</small></div><div><strong>20–500 pcs</strong><small>Indicative batch range</small></div><div><strong>OEM Focus</strong><small>Drawing-based production</small></div></div></div>
      <div class="hero-index">01 <span>/</span> 04</div>
    </section>
    <section class="trust-strip"><div class="container trust-inner"><span>BUILT AROUND YOUR ENGINEERING DRAWINGS</span><span>PRECISION COMPONENTS</span><span>PRODUCTION-FOCUSED</span><span>DIRECT RFQ PROCESS</span></div></section>
    <section class="section section-intro"><div class="container intro-grid"><div><span class="eyebrow">WHO WE ARE</span><h2>Reliable machining starts with <em>engineering clarity.</em></h2></div><div><p class="lead">Belaro Precision supports OEM manufacturers with CNC-machined metal components made to customer drawings and project requirements.</p><p>From initial drawing review to production and inspection, our focus is on clear communication, practical manufacturability and consistent execution. Every project is reviewed against its geometry, material, tolerance and quantity before a production commitment is made.</p><a class="text-link" href="/about/">More about Belaro <span>→</span></a></div></div></section>
    <section class="section section-soft"><div class="container"><SectionHeading eyebrow="WHAT WE DO" title="CNC capabilities for production components" text="Focused machining services for industrial parts, built around the requirements in your drawings."/><div class="capability-grid"><article class="cap-card"><img src="https://images.unsplash.com/photo-1567789884554-0b844b597180?auto=format&fit=crop&w=900&q=85" alt="CNC milling machine cutting a metal component"/><div class="cap-body"><span class="card-number">01 / MILLING</span><h3>CNC Milling</h3><p>Machined profiles, housings, brackets, plates and precision features for industrial assemblies.</p><a href="/services/#milling" class="text-link">Explore milling <span>→</span></a></div></article><article class="cap-card"><img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=900&q=85" alt="Precision manufacturing workshop"/><div class="cap-body"><span class="card-number">02 / TURNING</span><h3>CNC Turning</h3><p>Rotational components such as shafts, bushings, sleeves and turned features, subject to capability review.</p><a href="/services/#turning" class="text-link">Explore turning <span>→</span></a></div></article><article class="cap-card cap-card-dark"><div class="abstract-lines"></div><div class="cap-body"><span class="card-number">03 / OEM PRODUCTION</span><h3>Low-Volume<br/>Production</h3><p>Production-minded support for repeat orders and batch quantities aligned with your project needs.</p><a href="/services/#production" class="text-link text-link-light">How we work <span>→</span></a></div></article></div></div></section>
    <section class="section industries-preview"><div class="container"><div class="split-heading"><SectionHeading eyebrow="INDUSTRIES" title="Parts that keep industry moving" text="We focus on component requirements across selected industrial sectors."/><a class="button button-outline" href="/industries/">View industries <span>↗</span></a></div><div class="industry-grid"><a class="industry-card" href="/industries/#automation"><span>01</span><h3>Industrial<br/>Automation</h3><b>↗</b></a><a class="industry-card" href="/industries/#machinery"><span>02</span><h3>Industrial<br/>Machinery</h3><b>↗</b></a><a class="industry-card" href="/industries/#fluid"><span>03</span><h3>Hydraulic &<br/>Pneumatic</h3><b>↗</b></a><a class="industry-card" href="/industries/#laboratory"><span>04</span><h3>Laboratory &<br/>Testing Equipment</h3><b>↗</b></a></div></div></section>
    <section class="quality-band"><div class="container quality-band-grid"><div><span class="eyebrow eyebrow-light">QUALITY & CONTROL</span><h2>Precision is not a promise.<br/><em>It is a process to verify.</em></h2><p>Part requirements are reviewed against measurable inspection criteria. Tolerances and inspection documentation are confirmed for each project.</p><a class="button button-white" href="/quality/">Explore our quality approach <span>→</span></a></div><div class="quality-stat"><strong>±0.01–0.02</strong><span>mm</span><p>Typical achievable tolerance range on suitable features, subject to drawing, material, geometry and inspection conditions.</p></div></div></section>
    <section class="section process-section"><div class="container"><SectionHeading eyebrow="HOW IT WORKS" title="A clear path from drawing to delivery" text="A straightforward RFQ process helps both teams align on technical and commercial requirements."/><div class="process-grid"><div><b>01</b><h3>Send your drawing</h3><p>Share CAD files, PDF drawings and project details.</p></div><div><b>02</b><h3>Technical review</h3><p>We review geometry, material, tolerances and quantity.</p></div><div><b>03</b><h3>Quotation</h3><p>Receive pricing and a proposed production timeline.</p></div><div><b>04</b><h3>Manufacture & inspect</h3><p>Production and inspection follow agreed requirements.</p></div></div></div></section>
    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">HAVE A PART TO MAKE?</span><h2>Let’s review your next<br/><em>machining requirement.</em></h2><p>Send your drawing and key project details. We’ll review the requirements and respond with the next steps.</p></div><a class="button button-orange button-large" href="/contact/">Submit an RFQ <span>↗</span></a></div></section>
  </main><Footer />
</BaseLayout>

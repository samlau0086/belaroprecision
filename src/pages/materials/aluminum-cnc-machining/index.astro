---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RfqForm from '../../../components/RfqForm.astro';
import ProcessImage from '../../../components/ProcessImage.astro';
import { images } from '../../../data/images';
import bracket from '../../../../public/images/machined-parts/mounting-bracket-main.webp';
import block from '../../../../public/images/machined-parts/machined-block-main.webp';
import housing from '../../../../public/images/machined-parts/plates-housings-main.webp';
import shaft from '../../../../public/images/machined-parts/precision-shaft-main.webp';
import asMachinedFinish from '../../../assets/images/aluminum-finishes/as-machined-aluminum-mounting-bracket.webp';
import beadBlastedFinish from '../../../assets/images/aluminum-finishes/bead-blasted-aluminum-sensor-housing.webp';
import clearAnodizedFinish from '../../../assets/images/aluminum-finishes/clear-anodized-aluminum-flange-adapter.webp';
import hardAnodizedFinish from '../../../assets/images/aluminum-finishes/hard-anodized-aluminum-guide-carriage.webp';
import blueCoatedFinish from '../../../assets/images/aluminum-finishes/blue-coated-aluminum-equipment-cover.webp';

const parts = [
  { title: 'Mounting brackets', id: 'mounting-brackets', image: bracket, text: 'Mounting faces, slots and locating holes for equipment and mechanical assemblies.' },
  { title: 'Machined blocks', id: 'machined-blocks', image: block, text: 'Datum faces, pockets, bores and threaded features for locating and assembly interfaces.' },
  { title: 'Plates & housings', id: 'plates-housings', image: housing, text: 'Mounting patterns, pockets and enclosure interfaces reviewed for wall thickness and access.' },
  { title: 'Shafts & turned parts', id: 'precision-shafts', image: shaft, text: 'Stepped diameters, shoulders and mating features reviewed against the specified alloy and fits.' },
];
const processes = [
  ['CNC Milling', 'Faces, pockets, slots, bores and hole patterns for prismatic aluminum components.', '/services/cnc-milling/'],
  ['CNC Turning', 'Diameters, shoulders, bores and threads for rotational components.', '/services/cnc-turning/'],
  ['3-Axis Machining', 'Accessible features on plates, blocks, brackets and housings.', '/services/cnc-milling/#three-axis'],
  ['3+2-Axis Milling', 'Fixed-angle positioning for inclined faces and features on multiple sides; rotary axes remain stationary during cutting.', '/services/cnc-milling/#three-plus-two'],
  ['Simultaneous 5-Axis', 'Coordinated linear and rotary motion for complex surfaces and multi-directional tool access.', '/services/cnc-milling/#five-axis'],
];
const finishes = [
  { image: asMachinedFinish, title: 'As-Machined', text: 'Bare aluminum straight from CNC machining, with tool paths visible and no added coating.', alt: 'AI illustration of an as-machined aluminum mounting bracket with visible milling tool paths' },
  { image: beadBlastedFinish, title: 'Bead Blasting', text: 'Creates an even, low-gloss texture that softens the appearance of machining marks. Specify the desired texture and protected surfaces.', alt: 'AI illustration of a bead-blasted aluminum sensor housing with a matte silver texture' },
  { image: clearAnodizedFinish, title: 'Clear Anodizing', text: 'Adds a protective oxide layer for improved corrosion resistance while preserving a silver metallic appearance. Final tone depends on the alloy and preparation.', alt: 'AI illustration of a silver aluminum flange adapter for a clear-anodized appearance' },
  { image: hardAnodizedFinish, title: 'Hard Anodizing', text: 'Builds a wear-resistant oxide layer for demanding mechanical applications. Agree coating thickness, masking and final fits; color varies with alloy and process.', alt: 'AI illustration of a charcoal gray aluminum guide carriage for a hard-anodized appearance' },
  { image: blueCoatedFinish, title: 'Powder Coating', text: 'Applies a durable colored protective coating to suitable parts. Specify the color, gloss, coating thickness and areas that must remain uncoated.', alt: 'AI illustration of a blue-coated aluminum equipment cover with an exposed silver mounting rim' },
];
const faqs = [
  ['Which aluminum grade should I specify?', 'Use the grade, standard and temper required by your design. 6061, 6082 and 7075 are enquiry options, not a guarantee of stock or suitability. If the material is undecided, share the application and constraints for review; procurement and machining feasibility must be confirmed before ordering.'],
  ['What drawings and files do you need?', 'A dimensioned PDF drawing and a STEP model, if available, help define the component. Include the revision, material condition, quantity, datums, critical tolerances and finish. Upload one file up to 20 MB, or package related files in a ZIP.'],
  ['What machining accuracy can you achieve?', 'There is no universal tolerance for every aluminum component. We review feature size, geometry, material condition, fixturing and inspection requirements against your drawing. Critical dimensions and acceptance criteria must be agreed during quotation.'],
  ['Can I request bead blasting, anodizing or powder coating?', 'Include the treatment specification, color or appearance reference, masking areas and dimensions that apply after finishing. For clear or hard anodizing and powder coating, identify coating requirements and final fits. Supplier availability, compatibility, inspection and cost are confirmed before order acceptance.'],
  ['Do you accept small quantities and repeat orders?', 'There is no fixed minimum order quantity. Initial parts, low-volume batches and repeat production are reviewed according to geometry, setup and material requirements. Share both the immediate quantity and any expected recurring demand.'],
  ['Can I request inspection reports or material certificates?', 'List the documents you need in the RFQ, such as an FAI report, a CMM / dimensional report or an EN 10204 3.1 material certificate. Availability, measurement scope, traceability and any additional cost must be agreed; these documents are not automatically included.'],
  ['How are price and lead time confirmed?', 'Price and estimated lead time depend on the drawing, alloy availability, quantity, machining route, inspection and finishing scope. Send complete requirements for technical review and quotation. Production and delivery timing are confirmed for the specific order, not promised by this page.'],
];
---
<BaseLayout title="Aluminum CNC Machining for Precision OEM Components" description="Drawing-based aluminum CNC milling and turning for OEM brackets, housings, blocks, plates and shafts. Discuss alloy grades, tolerances, finishing and production requirements.">
  <Header quoteHref="#rfq-form" />
  <main class="aluminum-page">
    <section class="aluminum-hero" aria-labelledby="aluminum-title">
      <Image class="hero-photo" src={images['hero-cnc-milling']} alt="Milling tool machining a metal component" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="container hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="#aluminum-grades">Materials</a><span aria-hidden="true">/</span><span aria-current="page">Aluminum CNC Machining</span></nav>
        <span class="eyebrow eyebrow-light">ALUMINUM CNC MACHINING</span>
        <h1 id="aluminum-title">Precision Aluminum CNC Machining for OEM Components</h1>
        <p>Drawing-based aluminum components for industrial equipment, machinery, and OEM production.</p>
        <a class="button button-orange" href="#rfq-form">Request a Quote <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>

    <section class="section" id="capabilities" aria-labelledby="capabilities-title"><div class="container two-column">
      <div><span class="eyebrow">01 / CAPABILITIES</span><h2 id="capabilities-title">Aluminum Machining Capabilities</h2><p>Aluminum milling and turning for custom components made to your engineering drawing. The machining route follows the geometry, assembly requirements and critical features of your part.</p><ul class="check-list"><li>Faces, profiles, pockets and slots</li><li>Precision hole locations, bores and threaded features</li><li>Turned diameters, shoulders and mating interfaces</li><li>Complex geometry reviewed for tool access, thin walls and fixturing</li></ul><a class="text-link" href="/services/cnc-machining/">Explore CNC capabilities <span aria-hidden="true">&#8594;</span></a></div>
      <ProcessImage name="milling-process-detail" alt="Examples of CNC milling configurations and machined features" />
    </div></section>

    <section class="section section-soft" id="aluminum-grades" aria-labelledby="grades-title"><div class="container">
      <span class="eyebrow">02 / MATERIAL SELECTION</span><h2 id="grades-title">Aluminum Grades</h2><p class="section-lead">Start with the exact alloy and temper on your drawing. The following grades are listed in our enquiry form; stock, procurement, machining suitability and documentation are confirmed for each project.</p>
      <div class="grade-grid">{['6061', '6082', '7075'].map(grade => <article><span class="grade-label">ALUMINUM</span><h3>{grade}</h3><p>Specify the required temper, material standard, stock form and any certificate requirements with your enquiry.</p></article>)}</div>
      <p class="scope-note">Need another grade or help reviewing the specification? Include your requirements in the RFQ. No material substitution is assumed without agreement.</p>
    </div></section>

    <section class="section" id="components" aria-labelledby="components-title"><div class="container">
      <span class="eyebrow">03 / COMPONENT TYPES</span><h2 id="components-title">Typical Aluminum Components</h2><p class="section-lead">Representative part families for industrial assemblies. Images illustrate geometry, not verified aluminum grades, customer projects or stocked products.</p>
      <div class="parts-grid">{parts.map(part => <article class="part"><Image src={part.image} alt={`Representative ${part.title.toLowerCase()} geometry`} widths={[320, 480, 640]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1000px) 45vw, 270px" loading="lazy" /><div class="part-copy"><h3>{part.title}</h3><p>{part.text}</p><a class="text-link" href={`/machined-parts/#${part.id}`}>View part family <span aria-hidden="true">&#8594;</span></a></div></article>)}</div>
    </div></section>

    <section class="section section-soft" id="processes" aria-labelledby="processes-title"><div class="container">
      <span class="eyebrow">04 / MACHINING ROUTES</span><h2 id="processes-title">CNC Machining Processes</h2><p class="section-lead">Belaro supports the following machining configurations. Selection for an aluminum part depends on its drawing, material condition, tool access and required inspection.</p>
      <div class="process-list">{processes.map(([title, text, href]) => <article><h3><a href={href}>{title} <span aria-hidden="true">&#8599;</span></a></h3><p>{text}</p></article>)}</div>
    </div></section>

    <section class="section" id="quality" aria-labelledby="quality-title"><div class="container two-column">
      <div><span class="eyebrow">05 / INSPECTION</span><h2 id="quality-title">Tolerances &amp; Quality Control</h2><p>Identify the dimensions that control fit and function. Tolerance feasibility and the measurement approach are reviewed per feature, rather than covered by a blanket accuracy claim.</p><a class="text-link" href="/quality/">Our quality approach <span aria-hidden="true">&#8594;</span></a></div>
      <dl class="requirements"><div><dt>Datums &amp; critical features</dt><dd>Define locating faces, hole positions, fits, threads and surface requirements on the controlled drawing.</dd></div><div><dt>Dimensional verification</dt><dd>Agree measurement methods, acceptance criteria and first-part, sampling or full-inspection scope before production.</dd></div><div><dt>Inspection documents</dt><dd>Request the reports and material records you need. Equipment, document availability and coverage are confirmed during quotation.</dd></div><div><dt>After-finishing dimensions</dt><dd>State which dimensions apply after treatment, together with masking and cosmetic requirements.</dd></div></dl>
    </div></section>

    <section class="section section-soft" id="finishing" aria-labelledby="finishing-title"><div class="container">
      <span class="eyebrow">06 / FINISHING REQUIREMENTS</span><h2 id="finishing-title">Surface Finishing</h2><p class="section-lead">Surface finishing is coordinated through our Dongguan and Shenzhen supplier network where agreed. The requests below are assessed for supplier availability and suitability; they are not unconditional in-house capability claims.</p>
      <p class="finish-image-note">AI-generated appearance illustrations, not photographs of manufactured parts or verification of a finishing process. Actual texture and color are agreed per order.</p>
      <div class="finish-grid">{finishes.map(finish => <article>
          <Image src={finish.image} alt={finish.alt} widths={[320, 480, 800]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) 45vw, 370px" loading="lazy" />
          <h3>{finish.title}</h3><p>{finish.text}</p>
        </article>)}</div>
      <a class="text-link" href="/services/secondary-processes/">Discuss coordinated finishing <span aria-hidden="true">&#8594;</span></a>
    </div></section>

    <section class="section" id="production" aria-labelledby="production-title"><div class="container two-column">
      <div><span class="eyebrow">07 / ORDER PLANNING</span><h2 id="production-title">Production &amp; Orders</h2><p>Initial parts, low-volume batches, batch manufacturing and repeat orders are reviewed around your component. There is no fixed MOQ; setup, material availability and order suitability depend on the project.</p><a class="text-link" href="/services/production/">OEM production approach <span aria-hidden="true">&#8594;</span></a></div>
      <ol class="order-steps"><li><h3>Align the requirements</h3><p>Share the drawing revision, alloy, quantity, finishing and inspection needs.</p></li><li><h3>Confirm scope &amp; timing</h3><p>Agree the production route, price and estimated lead time after technical review.</p></li><li><h3>Plan repeat demand</h3><p>Provide forecasts and identify revisions or specification changes before each repeat order.</p></li></ol>
    </div></section>

    <section class="section section-soft" id="faq" aria-labelledby="faq-title"><div class="container two-column faq-layout"><div><span class="eyebrow">08 / BEFORE YOU ENQUIRE</span><h2 id="faq-title">Frequently Asked Questions</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

    <section class="section" id="quote" aria-labelledby="quote-title"><div class="container rfq-layout">
      <div class="rfq-intro"><span class="eyebrow">09 / REQUEST A QUOTE</span><h2 id="quote-title">Your drawing.<br/>Our technical review.</h2><p>Upload your drawing for an aluminum machining review and quotation. Include the alloy and temper, quantity, critical dimensions and required finish when available.</p><p>One file up to 20 MB; use a ZIP for multiple drawings and models. Document availability and delivery timing are confirmed during quotation.</p><p><a class="text-link" href="/contact/">Contact Belaro <span aria-hidden="true">&#8594;</span></a></p></div>
      <RfqForm />
    </div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .aluminum-page{letter-spacing:0}.aluminum-page h1,.aluminum-page h2,.aluminum-page h3,.aluminum-page .eyebrow{letter-spacing:0}
  .aluminum-hero{position:relative;background:var(--navy);color:#fff;isolation:isolate}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-2}.aluminum-hero::before{content:"";position:absolute;inset:0;background:rgba(9,23,42,.72);z-index:-1}.hero-copy{padding-block:40px 64px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;color:#d0d8e2;margin-bottom:36px}.hero-copy h1{font-size:52px;max-width:780px;line-height:1.16;margin-block:18px 22px}.hero-copy>p{max-width:590px;color:#e0e6ee;font-size:18px;margin-bottom:28px}
  h2{font-size:36px;line-height:1.25;margin:14px 0 24px}h3{font-size:22px;line-height:1.35}p,dd{color:var(--muted)}.section-lead{max-width:800px;margin-bottom:34px}.two-column{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:center}.two-column>div,.rfq-intro{min-width:0}
  .grade-grid,.finish-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.grade-grid article{background:#fff;border-top:2px solid var(--orange);padding:28px}.grade-label{font-size:16px;color:var(--muted)}.grade-grid h3{font-size:38px;margin:8px 0 16px}.grade-grid p{margin:0}.scope-note{border-left:3px solid var(--orange);padding:12px 20px;margin:28px 0 0}
  .parts-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.part{border:1px solid var(--line);display:flex;flex-direction:column;min-width:0}.part img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;background:var(--soft)}.part-copy{padding:22px;display:flex;flex-direction:column;flex:1}.part h3{margin-bottom:14px}.part .text-link{margin-top:auto}.part p{margin-bottom:22px}
  .process-list{border-top:1px solid var(--line)}.process-list article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:36px;border-bottom:1px solid var(--line);padding:24px 0}.process-list h3,.process-list p{margin:0}.process-list span{color:var(--orange)}.requirements{margin:0}.requirements>div{border-top:1px solid var(--line);padding:20px 0}.requirements dt{font-weight:700;margin-bottom:8px}.requirements dd{margin:0}
  .finish-grid{margin-bottom:28px}.finish-grid article{border-top:2px solid var(--orange);padding-top:24px;min-width:0}.finish-grid img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;margin-bottom:20px}.finish-grid p{margin-bottom:0}.order-steps{margin:0;padding-left:24px}.order-steps li{padding:18px 0 10px 10px;border-bottom:1px solid var(--line)}.order-steps li::marker{color:var(--orange);font-weight:700}.order-steps h3{margin-bottom:10px}.order-steps p{margin-bottom:14px}.faq-layout{align-items:start}.faq-list details{border-bottom:1px solid var(--line);padding:20px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer}.faq-list p{margin:16px 0 0}.aluminum-page a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:1100px){.two-column{gap:32px}.parts-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.hero-copy{padding-block:28px 48px}.hero-copy h1{font-size:36px}.hero-copy>p{font-size:16px}.breadcrumbs{margin-bottom:28px}h2{font-size:30px}.two-column,.grade-grid,.finish-grid,.parts-grid,.process-list article{grid-template-columns:minmax(0,1fr)}.grade-grid,.finish-grid{gap:24px}.process-list article{gap:12px}.part-copy{padding:24px}.faq-layout{gap:8px}}
</style>

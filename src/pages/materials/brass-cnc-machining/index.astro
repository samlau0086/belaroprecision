---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RfqForm from '../../../components/RfqForm.astro';
import { materialPages } from '../../../data/material-pages';
import hero from '../../../assets/images/materials/brass/brass-cnc-machining-connectors-hero.webp';
import capabilities from '../../../assets/images/materials/brass/brass-machined-port-body-features.webp';
import connector from '../../../assets/images/materials/brass/brass-cnc-threaded-adapter.webp';
import bushing from '../../../assets/images/materials/brass/brass-cnc-flanged-bushing.webp';
import insert from '../../../assets/images/materials/brass/brass-cnc-custom-threaded-insert-body.webp';
import turning from '../../../assets/images/materials/brass/brass-cnc-turning-adapter-shoulder.webp';
import threeAxis from '../../../assets/images/materials/brass/brass-three-axis-milling-wrench-flats.webp';
import indexed from '../../../assets/images/materials/brass/brass-indexed-milling-angled-port-body.webp';
import fiveAxis from '../../../assets/images/materials/brass/brass-five-axis-contoured-interface-body.webp';
import inspection from '../../../assets/images/materials/brass/brass-connector-thread-gauge-inspection.webp';
import plating from '../../../assets/images/materials/brass/brass-adapter-silver-tone-coating-concept.webp';
import polishing from '../../../assets/images/materials/brass/brass-polished-instrument-collar.webp';
import fitInspection from '../../../assets/images/materials/brass/brass-coated-connector-final-fit-inspection.webp';
import production from '../../../assets/images/materials/brass/brass-threaded-adapters-small-batch-packing.webp';

const material = materialPages.find(page => page.slug === 'brass-cnc-machining');
if (!material) throw new Error('Brass material data is missing');
const parts = [
  { title: 'Threaded connectors', image: connector, alt: 'Brass threaded adapter with machined hex flats', text: 'Threads, shoulders and mating faces reviewed against the drawing and assembly requirements.' },
  { title: 'Flanged bushings', image: bushing, alt: 'Brass flanged bushing with a stepped bore', text: 'Bores, flanges and bearing interfaces reviewed for fit, wall thickness and inspection access.' },
  { title: 'Custom threaded inserts', image: insert, alt: 'Brass custom threaded insert body', text: 'Custom bodies and inserts with internal threads, bores and locating features defined by the drawing.' },
];
const processes = [
  ['CNC Turning', 'Diameters, shoulders, bores and threads for rotational brass components.', turning],
  ['3-Axis Milling', 'Wrench flats, pockets, holes and accessible prismatic features.', threeAxis],
  ['3+2-Axis Milling', 'Fixed-angle positioning for inclined and multi-side features; rotary axes remain stationary during cutting.', indexed],
  ['Simultaneous 5-Axis', 'Coordinated linear and rotary motion for contoured interfaces where the drawing supports the route.', fiveAxis],
];
const finishes = [
  { title: 'Plating review', image: plating, alt: 'Brass adapter shown with a silver-tone coating concept', text: 'Illustrative finish. Specify the coating, masking, thickness and post-finish dimensions for review.' },
  { title: 'Polishing', image: polishing, alt: 'Polished brass instrument collar', text: 'Define cosmetic surfaces, edge treatment and acceptance lighting. Final appearance depends on the specified process and alloy.' },
  { title: 'Final fit inspection', image: fitInspection, alt: 'Coated brass connector during final fit inspection', text: 'After-treatment fit and appearance are checked against the agreed drawing and acceptance criteria.' },
];
const faqs = material.faqs;
---
<BaseLayout title={material.title} description={material.description}>
  <Header quoteHref="#rfq-form" />
  <main class="brass-page">
    <section class="material-hero brass-hero" aria-labelledby="brass-title">
      <Image class="hero-photo" src={hero} alt="Brass machined connectors arranged for inspection" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="container hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="#grades">Materials</a><span aria-hidden="true">/</span><span aria-current="page">Brass CNC Machining</span></nav><span class="eyebrow">BRASS CNC MACHINING</span><h1 id="brass-title">{material.title}</h1><p>{material.intro}</p><a class="button button-orange" href="#rfq-form">Request a Quote <span aria-hidden="true">&#8599;</span></a></div>
    </section>
    <nav class="section-index" aria-label="Page sections"><div class="container">{material.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#faq">FAQ</a><a href="#quote">Request a Quote</a></div></nav>
    <section class="section" id="capabilities" aria-labelledby="capabilities-title"><div class="container two-column"><div><span class="eyebrow">01 / CAPABILITIES</span><h2 id="capabilities-title">{material.sections[0].title}</h2><p>{material.sections[0].intro}</p><div class="review-list">{material.sections[0].items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div><a class="text-link" href="/services/cnc-machining/">Explore CNC capabilities <span aria-hidden="true">&#8594;</span></a></div><figure class="section-visual"><Image src={capabilities} alt="Brass machined port body with threaded and milled features" widths={[480, 800, 1200]} sizes="(max-width: 700px) calc(100vw - 36px), 45vw" loading="lazy" /></figure></div></section>
    <section class="section section-soft" id="grades" aria-labelledby="grades-title"><div class="container"><span class="eyebrow">02 / MATERIAL SELECTION</span><h2 id="grades-title">{material.sections[1].title}</h2><p class="section-lead">{material.sections[1].intro}</p><div class="grade-grid">{material.sections[1].items.map(([title, text]) => <article><span class="grade-label">BRASS</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="section" id="components" aria-labelledby="components-title"><div class="container"><span class="eyebrow">03 / COMPONENT TYPES</span><h2 id="components-title">{material.sections[2].title}</h2><p class="section-lead">{material.sections[2].intro}</p><div class="parts-grid">{parts.map(part => <article class="part"><Image src={part.image} alt={part.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) 45vw, 370px" loading="lazy" /><div class="part-copy"><h3>{part.title}</h3><p>{part.text}</p></div></article>)}</div></div></section>
    <section class="section section-soft" id="processes" aria-labelledby="processes-title"><div class="container"><span class="eyebrow">04 / MACHINING ROUTES</span><h2 id="processes-title">{material.sections[3].title}</h2><p class="section-lead">{material.sections[3].intro}</p><div class="process-list">{processes.map(([title, text, image]) => <article><Image src={image} alt={`${title} brass machining process context`} widths={[320, 480, 800]} sizes="(max-width: 700px) calc(100vw - 36px), 320px" loading="lazy" /><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
    <section class="section" id="quality" aria-labelledby="quality-title"><div class="container two-column"><div><span class="eyebrow">05 / INSPECTION</span><h2 id="quality-title">{material.sections[4].title}</h2><p>{material.sections[4].intro}</p><div class="review-list">{material.sections[4].items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div><figure class="section-visual"><Image src={inspection} alt="Thread gauge inspection of a brass connector" widths={[480, 800, 1200]} sizes="(max-width: 700px) calc(100vw - 36px), 45vw" loading="lazy" /></figure></div></section>
    <section class="section section-soft" id="finishing" aria-labelledby="finishing-title"><div class="container"><span class="eyebrow">06 / FINISHING REQUIREMENTS</span><h2 id="finishing-title">{material.sections[5].title}</h2><p class="section-lead">{material.sections[5].intro}</p><p class="scope-note">Images illustrate finishing options. Plating, polishing, supplier availability, masking and final dimensions are reviewed for each project.</p><div class="finish-grid">{finishes.map(finish => <article><Image src={finish.image} alt={finish.alt} widths={[320, 480, 800]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) 45vw, 370px" loading="lazy" /><h3>{finish.title}</h3><p>{finish.text}</p></article>)}</div></div></section>
    <section class="section" id="production" aria-labelledby="production-title"><div class="container two-column"><div><span class="eyebrow">07 / ORDER PLANNING</span><h2 id="production-title">{material.sections[6].title}</h2><p>{material.sections[6].intro}</p><div class="review-list">{material.sections[6].items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div><figure class="section-visual"><Image src={production} alt="Small batch of brass threaded adapters in protective packing" widths={[480, 800, 1200]} sizes="(max-width: 700px) calc(100vw - 36px), 45vw" loading="lazy" /></figure></div></section>
    <section class="section section-soft" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div><span class="eyebrow">08 / BEFORE YOU ENQUIRE</span><h2 id="faq-title">Frequently Asked Questions</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
    <section class="section" id="quote" aria-labelledby="quote-title"><div class="container rfq-layout"><div class="rfq-intro"><span class="eyebrow">09 / REQUEST A QUOTE</span><h2 id="quote-title">Your drawing.<br />Our technical review.</h2><p>Upload your drawing for a brass machining review and quotation.</p><p>{material.rfq}</p><p>One file up to 20 MB; use a ZIP for multiple drawings and models. Material availability, process scope, documents, price and estimated lead time are confirmed during quotation.</p><a class="text-link" href="/contact/">Contact Belaro Precision <span aria-hidden="true">&#8594;</span></a></div><RfqForm /></div></section>
  </main><Footer quoteHref="#rfq-form" />
</BaseLayout>
<style>
.brass-page{letter-spacing:0}.brass-page h1,.brass-page h2,.brass-page h3,.brass-page .eyebrow{letter-spacing:0}.brass-hero{position:relative;isolation:isolate;background:var(--navy);color:#fff}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.brass-hero:before{content:"";position:absolute;inset:0;background:rgba(9,23,42,.72);z-index:-1}.hero-copy{padding-block:40px 64px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;color:#d0d8e2;margin-bottom:36px}.hero-copy h1{font-size:52px;max-width:900px;line-height:1.16;margin:18px 0 22px}.hero-copy>p{max-width:710px;color:#e0e6ee;font-size:18px;margin-bottom:28px}.section-index{border-bottom:1px solid var(--line);background:var(--soft)}.section-index>div{display:flex;flex-wrap:wrap;gap:12px 28px;padding-block:22px}.section-index a{font-size:16px;color:var(--muted)}h2{font-size:36px;line-height:1.25;margin:14px 0 24px}h3{font-size:22px;line-height:1.35;margin:0}p{color:var(--muted)}.section-lead{max-width:800px;margin-bottom:34px}.two-column{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:start}.section-visual{margin:0}.section-visual img,.parts-grid img,.process-list img,.finish-grid img{display:block;width:100%;height:auto;object-fit:contain}.review-list{border-top:1px solid var(--line)}.review-list article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:28px;border-bottom:1px solid var(--line);padding:22px 0}.review-list p{margin:0}.grade-grid,.parts-grid,.finish-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.grade-grid article,.part,.finish-grid article{min-width:0}.grade-grid article{border-top:2px solid var(--orange);padding-top:18px}.grade-label{font-size:13px;letter-spacing:.08em;color:var(--orange2);font-weight:700}.parts-grid,.finish-grid{margin-top:30px}.part,.finish-grid article{border:1px solid var(--line);background:#fff}.part-copy,.finish-grid h3,.finish-grid p{margin-left:18px;margin-right:18px}.part-copy{padding:18px 0}.process-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.process-list article{display:grid;grid-template-columns:180px minmax(0,1fr);gap:20px;align-items:start;border-top:1px solid var(--line);padding-top:18px}.process-list h3{font-size:20px}.process-list p{margin-top:10px}.scope-note{color:var(--muted);font-size:15px}.faq-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:64px}.faq-list details{border-bottom:1px solid var(--line);padding:22px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer}.faq-list p{margin:16px 0 0}.rfq-intro{min-width:0}.brass-page a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(max-width:700px){.hero-copy{padding-block:28px 48px}.hero-copy h1{font-size:36px;overflow-wrap:break-word}.hero-copy>p{font-size:16px}.breadcrumbs{margin-bottom:28px}.two-column,.faq-layout{grid-template-columns:minmax(0,1fr);gap:28px}h2{font-size:30px}.review-list article{grid-template-columns:minmax(0,1fr);gap:10px}.grade-grid,.parts-grid,.finish-grid,.process-list{grid-template-columns:minmax(0,1fr)}.process-list article{grid-template-columns:120px minmax(0,1fr);gap:14px}.section-index>div{gap:12px 20px}}
</style>

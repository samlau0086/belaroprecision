---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import RfqForm from '../../../components/RfqForm.astro';
import { materialPages } from '../../../data/material-pages';
import hero from '../../../assets/images/materials/carbon-alloy-steel/carbon-alloy-steel-cnc-machining-oem-parts-hero.webp';
import capabilities from '../../../assets/images/materials/carbon-alloy-steel/steel-machined-bearing-mount-features.webp';
import shaft from '../../../assets/images/materials/carbon-alloy-steel/steel-cnc-stepped-shaft-and-sleeve.webp';
import plate from '../../../assets/images/materials/carbon-alloy-steel/steel-cnc-slotted-mounting-plate.webp';
import housing from '../../../assets/images/materials/carbon-alloy-steel/steel-cnc-actuator-interface-housing.webp';
import threeAxis from '../../../assets/images/materials/carbon-alloy-steel/steel-three-axis-milling-mounting-slot.webp';
import turning from '../../../assets/images/materials/carbon-alloy-steel/steel-cnc-turning-stepped-shaft.webp';
import indexed from '../../../assets/images/materials/carbon-alloy-steel/steel-indexed-milling-angled-mount.webp';
import fiveAxis from '../../../assets/images/materials/carbon-alloy-steel/steel-five-axis-contoured-housing.webp';
import roughShaft from '../../../assets/images/materials/carbon-alloy-steel/steel-rough-machined-shaft-process-planning.webp';
import cmm from '../../../assets/images/materials/carbon-alloy-steel/steel-housing-cmm-bore-inspection.webp';
import hardness from '../../../assets/images/materials/carbon-alloy-steel/steel-component-hardness-test-setup.webp';
import finish from '../../../assets/images/materials/carbon-alloy-steel/steel-dark-finish-mounting-collar-concept.webp';
import shipping from '../../../assets/images/materials/carbon-alloy-steel/steel-shaft-separated-shipping-protection.webp';
import production from '../../../assets/images/materials/carbon-alloy-steel/steel-mounting-parts-small-batch-tray.webp';

const material = materialPages.find(page => page.slug === 'carbon-alloy-steel-cnc-machining');
if (!material) throw new Error('Carbon & alloy steel material data is missing');
const parts = [
  { title: material.sections[2].items[0][0], text: material.sections[2].items[0][1], image: shaft, alt: 'Machined steel stepped shaft and locating sleeve' },
  { title: material.sections[2].items[1][0], text: material.sections[2].items[1][1], image: plate, alt: 'CNC-machined steel mounting plate with slots and counterbores' },
  { title: material.sections[2].items[2][0], text: material.sections[2].items[2][1], image: housing, alt: 'Steel actuator interface housing with an open bore and mounting flange' },
];
const processes = [
  { title: '3-Axis Milling', text: material.sections[3].items[0][1], image: threeAxis, alt: 'Three-axis milling a slot in a steel mounting plate' },
  { title: 'CNC Turning', text: material.sections[3].items[1][1], image: turning, alt: 'CNC turning a steel shaft supported by a tailstock' },
  { title: '3+2-Axis Milling', text: material.sections[3].items[2][1], image: indexed, alt: 'Indexed-angle milling setup for a steel equipment mount' },
  { title: 'Simultaneous 5-Axis', text: material.sections[3].items[3][1], image: fiveAxis, alt: 'Five-axis tool access for a contoured steel housing' },
  { title: 'Heat-treatment sequence', text: material.sections[3].items[4][1], image: roughShaft, alt: 'Rough-machined steel shaft prepared for process planning' },
];
const faq = material.faqs;
const imageProps = { widths: [480, 800, 1200], sizes: '(max-width: 700px) calc(100vw - 36px), 45vw', loading: 'lazy' as const };
---
<BaseLayout title={material.title} description={material.description}>
  <Header quoteHref="#rfq-form" />
  <main class="carbon-page">
    <section class="material-hero carbon-hero" aria-labelledby="carbon-title">
      <Image class="hero-photo" src={hero} alt="A steel stepped shaft and CNC-machined equipment mount" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="container hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="#grades">Materials</a><span aria-hidden="true">/</span><span aria-current="page">Carbon &amp; Alloy Steel CNC Machining</span></nav><span class="eyebrow">CARBON &amp; ALLOY STEEL CNC MACHINING</span><h1 id="carbon-title">{material.title}</h1><p>{material.intro}</p><a class="button button-orange" href="#rfq-form">Request a Quote <span aria-hidden="true">&#8599;</span></a></div>
    </section>
    <nav class="section-index" aria-label="Page sections"><div class="container">{material.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#faq">FAQ</a><a href="#quote">Request a Quote</a></div></nav>
    <section class="section" id="capabilities" aria-labelledby="capabilities-title"><div class="container two-column"><div><span class="eyebrow">01 / CAPABILITIES</span><h2 id="capabilities-title">{material.sections[0].title}</h2><p>{material.sections[0].intro}</p><div class="review-list">{material.sections[0].items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div><a class="text-link" href="/services/cnc-machining/">Explore CNC capabilities <span aria-hidden="true">&#8594;</span></a></div><figure class="section-visual"><Image src={capabilities} alt="Steel bearing mount with machined bore and mounting features" {...imageProps} /></figure></div></section>
    <section class="section section-soft" id="grades" aria-labelledby="grades-title"><div class="container"><span class="eyebrow">02 / MATERIAL SELECTION</span><h2 id="grades-title">{material.sections[1].title}</h2><p class="section-lead">{material.sections[1].intro}</p><div class="grade-grid">{material.sections[1].items.map(([title, text]) => <article><span class="grade-label">CARBON &amp; ALLOY STEEL</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
    <section class="section" id="components" aria-labelledby="components-title"><div class="container"><span class="eyebrow">03 / COMPONENT TYPES</span><h2 id="components-title">{material.sections[2].title}</h2><p class="section-lead">{material.sections[2].intro}</p><div class="parts-grid">{parts.map(part => <article class="part"><Image src={part.image} alt={part.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1100px) 45vw, 370px" loading="lazy" /><div class="part-copy"><h3>{part.title}</h3><p>{part.text}</p></div></article>)}</div></div></section>
    <section class="section section-soft" id="processes" aria-labelledby="processes-title"><div class="container"><span class="eyebrow">04 / MACHINING ROUTES</span><h2 id="processes-title">{material.sections[3].title}</h2><p class="section-lead">{material.sections[3].intro}</p><p class="scope-note">Images illustrate machining routes. Discuss heat-treatment order, remaining stock, distortion limits and any finish machining or grinding for your part.</p><div class="process-list">{processes.map(process => <article><Image src={process.image} alt={process.alt} widths={[320, 480, 800]} sizes="(max-width: 700px) 120px, 180px" loading="lazy" /><div><h3>{process.title}</h3><p>{process.text}</p></div></article>)}</div></div></section>
    <section class="section" id="quality" aria-labelledby="quality-title"><div class="container"><span class="eyebrow">05 / INSPECTION</span><h2 id="quality-title">{material.sections[4].title}</h2><p class="section-lead">{material.sections[4].intro}</p><div class="quality-grid">{[0, 2].map(index => <article><Image src={index === 2 ? hardness : cmm} alt={index === 2 ? 'Hardness-test setup on a supported steel component' : 'CMM inspection setup for a steel housing bore'} {...imageProps} /><h3>{material.sections[4].items[index][0]}</h3><p>{material.sections[4].items[index][1]}</p></article>)}</div><p class="scope-note">{material.sections[4].items[1][0]}: {material.sections[4].items[1][1]} Images illustrate inspection methods. Test methods, locations and records are agreed per order.</p></div></section>
    <section class="section section-soft" id="finishing" aria-labelledby="finishing-title"><div class="container"><span class="eyebrow">06 / FINISHING REQUIREMENTS</span><h2 id="finishing-title">{material.sections[5].title}</h2><p class="section-lead">{material.sections[5].intro}</p><div class="finish-grid"><article><Image src={finish} alt="Appearance concept of a dark-finished steel collar with a masked bore" {...imageProps} /><h3>{material.sections[5].items[0][0]}</h3><p>{material.sections[5].items[0][1]}</p></article><article><Image src={shipping} alt="Steel shafts separated and protected for shipping" {...imageProps} /><h3>{material.sections[5].items[1][0]}</h3><p>{material.sections[5].items[1][1]}</p></article></div><p class="scope-note">Specify the required treatment, corrosion protection, prohibited residues and packing materials for your order.</p></div></section>
    <section class="section" id="production" aria-labelledby="production-title"><div class="container two-column"><div><span class="eyebrow">07 / ORDER PLANNING</span><h2 id="production-title">{material.sections[6].title}</h2><p>{material.sections[6].intro}</p><div class="review-list">{material.sections[6].items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div><figure class="section-visual"><Image src={production} alt="Small batch of machined steel mounting parts in a tray" {...imageProps} /></figure></div></section>
    <section class="section section-soft" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div><span class="eyebrow">08 / BEFORE YOU ENQUIRE</span><h2 id="faq-title">Frequently Asked Questions</h2></div><div class="faq-list">{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
    <section class="section" id="quote" aria-labelledby="quote-title"><div class="container rfq-layout"><div class="rfq-intro"><span class="eyebrow">09 / REQUEST A QUOTE</span><h2 id="quote-title">Your drawing.<br />Our technical review.</h2><p>Upload your drawing for a carbon and alloy steel machining review and quotation.</p><p>{material.rfq}</p><p>One file up to 20 MB; use a ZIP for multiple drawings and models. Material availability, process scope, documents, price and estimated lead time are confirmed during quotation.</p><a class="text-link" href="/contact/">Contact Belaro <span aria-hidden="true">&#8594;</span></a></div><RfqForm /></div></section>
  </main><Footer quoteHref="#rfq-form" />
</BaseLayout>
<style>
.carbon-page{letter-spacing:0}.carbon-page h1,.carbon-page h2,.carbon-page h3,.carbon-page .eyebrow{letter-spacing:0}.carbon-hero{position:relative;isolation:isolate;background:var(--navy);color:#fff}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.carbon-hero:before{content:"";position:absolute;inset:0;background:rgba(9,23,42,.72);z-index:-1}.hero-copy{padding-block:40px 64px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;color:#d0d8e2;margin-bottom:36px}.hero-copy h1{font-size:52px;max-width:900px;line-height:1.16;margin:18px 0 22px}.hero-copy>p{max-width:710px;color:#e0e6ee;font-size:18px;margin-bottom:28px}.section-index{border-bottom:1px solid var(--line);background:var(--soft)}.section-index>div{display:flex;flex-wrap:wrap;gap:12px 28px;padding-block:22px}.section-index a{font-size:16px;color:var(--muted)}h2{font-size:36px;line-height:1.25;margin:14px 0 24px}h3{font-size:22px;line-height:1.35;margin:0}p{color:var(--muted)}.section-lead{max-width:800px;margin-bottom:34px}.two-column{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:start}.section-visual{margin:0}.section-visual img,.parts-grid img,.process-list img,.finish-grid img,.quality-grid img{display:block;width:100%;height:auto;object-fit:contain}.review-list{border-top:1px solid var(--line)}.review-list article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:28px;border-bottom:1px solid var(--line);padding:22px 0}.review-list p{margin:0}.grade-grid,.parts-grid,.finish-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.grade-grid article,.part,.finish-grid article{min-width:0}.grade-grid article{border-top:2px solid var(--orange);padding-top:18px}.grade-label{font-size:13px;color:var(--orange2);font-weight:700}.parts-grid,.finish-grid{margin-top:30px}.part,.finish-grid article{border:1px solid var(--line);background:#fff}.part-copy,.finish-grid h3,.finish-grid p{margin-left:18px;margin-right:18px}.part-copy{padding:18px 0}.process-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.process-list article{display:grid;grid-template-columns:180px minmax(0,1fr);gap:20px;align-items:start;border-top:1px solid var(--line);padding-top:18px}.process-list h3{font-size:20px}.process-list p{margin-top:10px}.quality-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:28px}.quality-grid article{min-width:0;border-top:1px solid var(--line);padding-top:18px}.quality-grid h3{margin-top:16px}.scope-note{color:var(--muted);font-size:15px}.faq-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:64px}.faq-list details{border-bottom:1px solid var(--line);padding:22px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer}.faq-list p{margin:16px 0 0}.rfq-intro{min-width:0}.carbon-page a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(max-width:700px){.hero-copy{padding-block:28px 48px}.hero-copy h1{font-size:36px;overflow-wrap:break-word}.hero-copy>p{font-size:16px}.breadcrumbs{margin-bottom:28px}.two-column,.faq-layout{grid-template-columns:minmax(0,1fr);gap:28px}h2{font-size:30px}.review-list article{grid-template-columns:minmax(0,1fr);gap:10px}.grade-grid,.parts-grid,.finish-grid,.process-list,.quality-grid{grid-template-columns:minmax(0,1fr)}.process-list article{grid-template-columns:120px minmax(0,1fr);gap:14px}.section-index>div{gap:12px 20px}}
</style>

---
interface Props { name: string; alt: string; width?: number; height?: number; }
const { name, alt, width = 1586, height = 992 } = Astro.props;
---
<figure class="process-image"><img src={`/images/${name}.webp`} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></figure>
<style>
  .process-image{margin:0;min-width:0;overflow:hidden}
  .process-image img{display:block;width:100%;height:auto}
</style>

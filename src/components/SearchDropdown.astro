---
interface Props {
  name: string;
  label: string;
  placeholder: string;
  options: { name: string; code: string; callingCode?: string }[];
  required?: boolean;
  allowCustom?: boolean;
  showFlags?: boolean;
}
const { name, label, placeholder, options, required = false, allowCustom = false, showFlags = false } = Astro.props;
---
<div class="country-field" data-search-dropdown data-allow-custom={String(allowCustom)} data-show-flags={String(showFlags)} data-label={label}>
  <label for={allowCustom ? `${name}-search` : `${name}-select`}>{label}{required ? ' *' : ''}</label>
  <select id={`${name}-select`} name={allowCustom ? undefined : name} required={required && !allowCustom} hidden={allowCustom} disabled={allowCustom}>
    <option value="">{placeholder}</option>
    {options.map(({ code, name, callingCode }) => <option value={name} data-code={code} data-calling-code={callingCode}>{name}</option>)}
  </select>
  <div class="country-combobox" hidden={!allowCustom}>
    <div class="country-input-wrap">
      <span class="country-selected-flag" aria-hidden="true" hidden></span>
      <input id={`${name}-search`} name={allowCustom ? name : undefined} type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${name}-options`} autocomplete="off" placeholder={placeholder} disabled={!allowCustom} required={required && allowCustom}/>
      <button type="button" class="country-toggle" aria-label={`Show ${label.toLowerCase()} options`} aria-controls={`${name}-options`} aria-expanded="false" tabindex="-1"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
    </div>
    <div class="country-popup" hidden>
      <ul id={`${name}-options`} role="listbox" aria-label={`${label} options`}></ul>
      <p class="country-empty" hidden>{allowCustom ? 'No matching materials. You can enter your own material.' : 'No countries or regions found.'}</p>
    </div>
    <span class="country-announcement" role="status" aria-live="polite"></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-search-dropdown]').forEach(field => {
    const select = field.querySelector('select')!;
    const label = field.querySelector('label')!;
    const combo = field.querySelector<HTMLElement>('.country-combobox')!;
    const input = field.querySelector('input')!;
    const toggle = field.querySelector('button')!;
    const popup = field.querySelector<HTMLElement>('.country-popup')!;
    const list = field.querySelector('ul')!;
    const empty = field.querySelector<HTMLElement>('.country-empty')!;
    const announcement = field.querySelector<HTMLElement>('.country-announcement')!;
    const allowCustom = field.dataset.allowCustom === 'true';
    const showFlags = field.dataset.showFlags === 'true';
    const selectedFlag = field.querySelector<HTMLElement>('.country-selected-flag')!;
    const name = select.name || input.name;
    const required = select.required || input.required;
    const countries = Array.from(select.options).filter(option => option.value).map(option => ({ name: option.value, code: option.dataset.code! }));
    let filtered = countries;
    let active = -1;
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const validate = () => {
      const match = countries.find(country => normalize(country.name) === normalize(input.value));
      input.setCustomValidity(!allowCustom && input.value && !match ? 'Please select a country or region from the list.' : '');
      selectedFlag.className = `country-selected-flag${match && showFlags ? ` fi fi-${match.code.toLowerCase()}` : ''}`;
      selectedFlag.hidden = !match || !showFlags;
      input.classList.toggle('has-flag', Boolean(match && showFlags));
      return match;
    };
    const close = () => {
      popup.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };
    const highlight = (index: number) => {
      active = index;
      Array.from(list.children).forEach((option, i) => {
        option.classList.toggle('is-active', i === active);
      });
      const option = list.children[active];
      if (option) {
        input.setAttribute('aria-activedescendant', option.id);
        option.scrollIntoView({ block: 'nearest' });
      } else input.removeAttribute('aria-activedescendant');
    };
    const choose = (name: string) => {
      input.value = name;
      validate();
      close();
      input.focus();
      input.dispatchEvent(new Event('change', { bubbles: true }));
    };
    const open = (query = '') => {
      const term = normalize(query);
      filtered = countries.filter(country => normalize(country.name).includes(term) || country.code.toLowerCase().includes(term));
      list.replaceChildren(...filtered.map((country, index) => {
        const option = document.createElement('li');
        option.id = `${name}-option-${index}`;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', String(country.name === input.value));
        if (showFlags) {
          const flag = document.createElement('span');
          flag.className = `fi fi-${country.code.toLowerCase()}`;
          flag.setAttribute('aria-hidden', 'true');
          option.append(flag);
        }
        option.append(document.createTextNode(country.name));
        option.addEventListener('click', () => choose(country.name));
        option.addEventListener('pointermove', () => highlight(index));
        return option;
      }));
      empty.hidden = filtered.length > 0;
      announcement.textContent = filtered.length ? `${filtered.length} ${field.dataset.label?.toLowerCase()} options available.` : empty.textContent;
      popup.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-expanded', 'true');
      highlight(-1);
    };
    if (!allowCustom) input.value = select.value;
    select.hidden = true;
    select.disabled = true;
    select.removeAttribute('name');
    combo.hidden = false;
    input.disabled = false;
    input.required = required;
    input.name = name;
    label.htmlFor = input.id;
    validate();
    input.addEventListener('focus', () => open());
    input.addEventListener('click', () => { if (popup.hidden) open(); });
    input.addEventListener('input', () => { validate(); open(input.value); });
    input.addEventListener('blur', () => {
      const match = validate();
      if (match) input.value = match.name;
    });
    // Keep focus on the combobox until an option's click has selected its value.
    list.addEventListener('pointerdown', event => event.preventDefault());
    toggle.addEventListener('pointerdown', event => event.preventDefault());
    toggle.addEventListener('click', () => {
      if (popup.hidden) { input.focus(); open(); } else close();
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (popup.hidden) open(input.value);
        const direction = event.key === 'ArrowDown' ? 1 : -1;
        if (filtered.length) highlight(active < 0 ? (direction === 1 ? 0 : filtered.length - 1) : (active + direction + filtered.length) % filtered.length);
      } else if (event.key === 'Enter' && !popup.hidden) {
        event.preventDefault();
        if (active >= 0) choose(filtered[active].name);
        else if (filtered.length === 1) choose(filtered[0].name);
        else if (allowCustom) close();
      } else if (event.key === 'Escape' && !popup.hidden) {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') close();
    });
    field.addEventListener('focusout', event => {
      if (!field.contains(event.relatedTarget as Node | null)) close();
    });
    document.addEventListener('pointerdown', event => {
      if (!field.contains(event.target as Node)) close();
    });
    input.form?.addEventListener('reset', () => { input.value = ''; validate(); close(); });
  });
</script>

<style>
  .country-field{display:flex;flex-direction:column;gap:7px;min-width:0}
  .country-combobox{position:relative}
  .country-input-wrap{position:relative}
  .country-field .country-input-wrap input{padding-right:40px}
  .country-field .country-input-wrap input.has-flag{padding-left:43px}
  .country-selected-flag{position:absolute;left:13px;top:50%;z-index:1;transform:translateY(-50%);width:20px;box-shadow:0 0 0 1px rgba(16,31,53,.12)}
  .country-toggle{position:absolute;right:1px;top:1px;bottom:1px;display:grid;place-items:center;width:38px;border:0;background:transparent;color:var(--muted);cursor:pointer}
  .country-popup{position:absolute;top:calc(100% + 5px);left:0;right:0;z-index:10;border:1px solid var(--line);background:#fff;box-shadow:0 10px 25px rgba(16,31,53,.12);font-size:16px;font-weight:400}
  .country-popup :global(ul){list-style:none;margin:0;padding:5px 0;max-height:250px;overflow-y:auto;overscroll-behavior:contain}
  .country-popup :global(li){display:flex;align-items:center;gap:11px;padding:10px 13px;cursor:pointer;overflow-wrap:anywhere}
  .country-popup :global(li .fi){width:20px;flex:0 0 20px;box-shadow:0 0 0 1px rgba(16,31,53,.12)}
  .country-popup :global(li.is-active){background:#fff0e5;color:var(--ink)}
  .country-popup :global(li[aria-selected=true]){font-weight:700;color:var(--orange2)}
  .country-empty{margin:0;padding:12px 13px;color:var(--muted)}
  .country-field [hidden]{display:none}
  .country-announcement{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
</style>

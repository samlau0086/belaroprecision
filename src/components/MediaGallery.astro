---
import ProcessImage from './ProcessImage.astro';
import { images } from '../data/images';

export interface MediaItem {
  name: keyof typeof images;
  alt: string;
  title: string;
  caption: string;
  document?: boolean;
}
interface Props { items: MediaItem[] }
const { items } = Astro.props;
---
<div class:list={['media-gallery', { 'single-media': items.length === 1 }]}>
  {items.map(item => <div class:list={['media-card', { 'document-card': item.document }]}>
    {item.document ? <a class="document-preview" href={images[item.name].src} target="_blank" rel="noopener" aria-label="Open sample inspection report at full size (new tab)"><ProcessImage name={item.name} alt={item.alt} /></a> : <ProcessImage name={item.name} alt={item.alt} />}
    <div class="media-caption"><p class="media-title">{item.title}</p><p>{item.caption}</p>{item.document && <a class="text-link" href={images[item.name].src} target="_blank" rel="noopener">View full-size sample <span aria-hidden="true">↗</span></a>}</div>
  </div>)}
</div>
<style>
  .media-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:32px}.media-card{min-width:0;background:white;border:1px solid var(--line);overflow:hidden}.media-card :global(.process-image img){aspect-ratio:3/2;object-fit:cover}.media-caption{padding:20px 24px}.media-caption p{margin:0;color:var(--muted);font-size:14px}.media-caption .media-title{font-weight:700;color:var(--ink);font-size:18px;margin-bottom:8px}.single-media{grid-template-columns:minmax(0,1fr)}.document-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center}.document-preview{display:block;background:var(--soft);padding:20px}.document-card :global(.process-image){max-width:460px;margin-inline:auto}.document-card :global(.process-image img){aspect-ratio:auto;object-fit:contain}.document-card .text-link{margin-top:18px;font-size:14px}a:focus-visible{outline:3px solid var(--orange);outline-offset:-3px}
  @media(max-width:700px){.media-gallery,.document-card{grid-template-columns:minmax(0,1fr)}.media-caption{padding:18px 20px}}
</style>

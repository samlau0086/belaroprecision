---
interface Props {
  block: {
    heading?: string;
    description?: string;
    buttonType?: string | string[];
    buttonLabel?: string;
    link?: { url?: string; title?: string; target?: string };
    document?: { node?: { mediaItemUrl?: string } };
    backgroundImage?: { node?: { sourceUrl?: string } };
    minHeight?: number | string;
    width?: string | string[];
  };
}

const { block } = Astro.props;
const option = (value: string | string[] | undefined) => Array.isArray(value) ? value[0] : value;
const safeUrl = (value: string | undefined, asset = false) => {
  if (!value?.trim()) return undefined;
  try {
    const url = new URL(value, Astro.site || 'https://belaroprecision.com');
    return (asset ? ['http:', 'https:'] : ['http:', 'https:', 'mailto:', 'tel:']).includes(url.protocol) ? value : undefined;
  } catch { return undefined; }
};
const height = Number(block.minHeight);
const minHeight = Number.isFinite(height) && height >= 100 && height <= 2000 ? height : 480;
const backgroundUrl = safeUrl(block.backgroundImage?.node?.sourceUrl, true);
const isDocument = option(block.buttonType) === 'document';
const buttonUrl = safeUrl(isDocument ? block.document?.node?.mediaItemUrl : block.link?.url, isDocument);
const buttonLabel = block.buttonLabel?.trim() || (isDocument ? 'Download document' : block.link?.title?.trim());
const newTab = !isDocument && block.link?.target === '_blank';
---

<section
  class:list={['fixed-background', { 'fixed-background--wide': option(block.width) === 'wide' }]}
  style={{ minHeight: `${minHeight}px`, '--fixed-background-image': backgroundUrl ? `url(${JSON.stringify(backgroundUrl)})` : undefined }}
>
  <div class="fixed-background__content">
    {block.heading && <h2>{block.heading}</h2>}
    {block.description && <p>{block.description}</p>}
    {buttonUrl && buttonLabel && (
      <a class="fixed-background__button" href={buttonUrl} target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener noreferrer' : undefined}>
        {buttonLabel}
      </a>
    )}
  </div>
</section>

<script>
  const backgrounds = [...document.querySelectorAll<HTMLElement>('.fixed-background')];
  if (backgrounds.length) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const update = () => {
      frame = 0;
      // 先统一读取布局，再写入偏移，避免多个模块反复触发布局计算。
      const measurements = backgrounds.map(element => ({ element, bounds: element.getBoundingClientRect() }));
      for (const { element, bounds } of measurements) {
        const travel = reducedMotion.matches ? 0 : (window.innerHeight + bounds.height) * 0.5;
        const offset = Math.max(-travel / 2, Math.min(travel / 2, (window.innerHeight / 2 - bounds.top - bounds.height / 2) * 0.5));
        element.style.setProperty('--background-travel', `${travel}px`);
        element.style.setProperty('--background-offset', `${offset}px`);
      }
    };
    const scheduleUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    reducedMotion.addEventListener('change', scheduleUpdate);
    const observer = new ResizeObserver(scheduleUpdate);
    backgrounds.forEach(element => observer.observe(element));
    update();
  }
</script>

<style>
  /* 背景上下留出视差行程，滚动到模块边缘时也不会露出空白。 */
  .fixed-background { position: relative; isolation: isolate; overflow: hidden; display: grid; place-items: center; margin: 2.5rem 0; padding: 3rem 1.5rem; background-color: #26384a; color: #fff; text-align: center; }
  .fixed-background::before { content: ''; position: absolute; inset: calc(var(--background-travel, 0px) / -2) 0; z-index: -1; pointer-events: none; background-image: var(--fixed-background-image, none); background-position: center; background-size: cover; transform: translate3d(0, var(--background-offset, 0px), 0); }
  .fixed-background::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: rgb(0 0 0 / 55%); }
  .fixed-background--wide { width: min(1440px, calc(100vw - 3rem)); margin-inline: calc((100% - min(1440px, calc(100vw - 3rem))) / 2); }
  .fixed-background .fixed-background__content { min-width: 0; max-width: 720px; overflow-wrap: anywhere; }
  .fixed-background .fixed-background__content h2 { margin: 0 0 1rem; color: #fff; font-size: 2rem; line-height: 1.25; letter-spacing: 0; }
  .fixed-background .fixed-background__content p { margin: 0; color: #fff; white-space: pre-line; }
  .fixed-background .fixed-background__content .fixed-background__button { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; min-height: 44px; margin-top: 1.5rem; padding: .75rem 1.25rem; background: #a95412; color: #fff; font-weight: 700; line-height: 1.5; text-decoration: none; }
  .fixed-background__button:hover { background: #87410c; }
  .fixed-background__button:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  @media (max-width: 620px) {
    .fixed-background { padding: 2rem 1.25rem; }
    .fixed-background .fixed-background__content h2 { font-size: 1.6rem; }
  }
  /* 无脚本时自然显示静态背景；减少动态效果时同步移除视差行程。 */
  @media (prefers-reduced-motion: reduce) {
    .fixed-background::before { inset: 0; transform: none; }
  }
</style>

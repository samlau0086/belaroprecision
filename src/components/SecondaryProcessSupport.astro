---
interface Props {
  soft?: boolean;
  eyebrow?: string;
  title?: string;
  text?: string;
}

const {
  soft = false,
  eyebrow = 'BEYOND MACHINING',
  title = 'Secondary processes coordinated around your part',
  text = 'Based in Shenzhen, Belaro can coordinate selected post-machining processes through its supplier network in Dongguan and Shenzhen. The required route, specification and inspection scope are confirmed for each project.',
} = Astro.props;
---

<section class:list={["section", { "section-soft": soft }]}>
  <div class="container secondary-support">
    <div class="secondary-intro">
      <div><span class="eyebrow">{eyebrow}</span><h2>{title}</h2></div>
      <div><p>{text}</p><a class="text-link" href="/services/secondary-processes/">Explore secondary processes <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="secondary-process-grid">
      <article><span>01</span><h3>Grinding</h3><p>For drawings that require a grinding step after machining, subject to geometry, tolerance and process review.</p></article>
      <article><span>02</span><h3>Heat Treatment</h3><p>Coordinated to the material condition, hardness or treatment specification stated in your requirements.</p></article>
      <article><span>03</span><h3>Surface Finishing</h3><p>Reviewed against the finish specification, masking needs, functional surfaces and post-finish dimensions.</p></article>
    </div>
  </div>
</section>

<style>
  .secondary-support{display:grid;gap:48px}.secondary-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:80px;align-items:start}.secondary-intro h2{font-size:clamp(34px,4vw,52px);line-height:1.1;margin:16px 0 0;letter-spacing:-1.5px}.secondary-intro p{margin:0 0 22px;color:var(--muted);font-size:18px}.secondary-process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.secondary-process-grid article{min-width:0;border-top:2px solid var(--orange);padding:23px 0 0}.secondary-process-grid article>span{font:700 12px var(--display);color:var(--orange);letter-spacing:1px}.secondary-process-grid h3{margin:14px 0 10px;font-size:22px}.secondary-process-grid p{margin:0;color:var(--muted)}
  @media(max-width:700px){.secondary-support{gap:36px}.secondary-intro,.secondary-process-grid{grid-template-columns:minmax(0,1fr)}.secondary-intro{gap:20px}.secondary-process-grid{gap:30px}.secondary-intro h2{font-size:34px}}
</style>

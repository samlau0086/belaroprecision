---
import { liveChat } from '../config';
---
<button class:list={['back-to-top', { 'with-livechat': liveChat.enabled }]} type="button" aria-label="Back to top" title="Back to top" data-back-to-top hidden>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    let pendingReturn = false;
    let restoreFocus = false;
    let fallbackTimer: number | undefined;
    const cancelReturn = () => {
      window.clearTimeout(fallbackTimer);
      fallbackTimer = undefined;
      pendingReturn = false;
      restoreFocus = false;
    };
    const finishReturn = () => {
      if (!pendingReturn || window.scrollY > 1) return;
      const shouldFocus = restoreFocus;
      cancelReturn();
      // 仅键盘或辅助技术激活时，在滚动结束后恢复焦点，避免干扰触屏滚动。
      if (shouldFocus) document.querySelector<HTMLAnchorElement>('.site-header .brand')?.focus({ preventScroll: true });
    };
    const updateVisibility = () => {
      button.hidden = window.scrollY < window.innerHeight;
      finishReturn();
    };
    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility);
    window.addEventListener('pageshow', updateVisibility);
    updateVisibility();

    // 用户开始其他操作时取消兜底，避免主动滚动或打开菜单后突然跳顶。
    for (const type of ['pointerdown', 'touchstart', 'wheel', 'keydown']) {
      document.addEventListener(type, cancelReturn, { passive: true, capture: true });
    }
    window.addEventListener('pagehide', cancelReturn);

    button.addEventListener('click', (event) => {
      cancelReturn();
      pendingReturn = true;
      restoreFocus = event.detail === 0;
      // 即使滚动已进入首屏、按钮隐藏，仍需保证到达真正的页顶。
      fallbackTimer = window.setTimeout(() => {
        if (pendingReturn && window.scrollY > 1) window.scrollTo({ top: 0, behavior: 'instant' });
        updateVisibility();
      }, 1200);
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      updateVisibility();
    });
  }
</script>

<style>
  .back-to-top{position:fixed;right:calc(24px + env(safe-area-inset-right,0px));bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:19;display:grid;place-items:center;width:48px;height:48px;padding:0;border:1px solid var(--orange);border-radius:50%;background:var(--navy);color:#fff;box-shadow:0 4px 18px rgba(16,31,53,.2);cursor:pointer;transition:background .2s,border-color .2s}
  .back-to-top[hidden]{display:none}
  /* 仅鼠标设备启用悬停，避免触屏先进入 hover 状态而需要再次点击。 */
  @media(hover:hover) and (pointer:fine){.back-to-top:hover{background:var(--navy2);border-color:#fff}}
  .back-to-top:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:700px){.back-to-top{right:calc(18px + env(safe-area-inset-right,0px));bottom:calc(82px + env(safe-area-inset-bottom,0px))}}
  @media(prefers-reduced-motion:reduce){.back-to-top{transition:none}}
  .back-to-top.with-livechat{bottom:calc(168px + env(safe-area-inset-bottom,0px))}
</style>

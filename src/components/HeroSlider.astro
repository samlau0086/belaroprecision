---
const millingImage = 'https://images.unsplash.com/photo-1567789884554-0b844b597180?auto=format&fit=crop&w=2000&q=90';
const workshopImage = 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=2000&q=90';
const slides = [
  {
    label: 'CNC MACHINING FOR INDUSTRIAL OEMS', title: 'Precision CNC Machining', accent: 'for OEM Manufacturers.',
    text: 'Drawing-based machined components for industrial machinery, automation systems and demanding production applications.',
    link: '/services/', action: 'Explore capabilities', image: millingImage, position: 'center',
  },
  {
    label: 'CNC MILLING & TURNING', title: 'Your drawing.', accent: 'Our machining focus.',
    text: 'From milled housings and brackets to turned shafts and sleeves, every component starts with a review of your requirements.',
    link: '/services/#milling', action: 'Explore machining', image: workshopImage, position: 'center',
  },
  {
    label: 'QUALITY & INSPECTION', title: 'Critical dimensions.', accent: 'Clear inspection criteria.',
    text: 'Align tolerances, material requirements and inspection documentation before production begins, with capability reviewed for each part.',
    link: '/quality/', action: 'Our quality approach', image: millingImage, position: '75% center',
  },
  {
    label: 'LOW-VOLUME OEM PRODUCTION', title: 'Built for your next batch.', accent: 'Ready for repeat orders.',
    text: 'Production support for drawing-based OEM components, with batch quantities and manufacturing requirements confirmed for your project.',
    link: '/services/#production', action: 'Explore production', image: workshopImage, position: '75% center',
  },
];
---
<section id="home-hero" class="hero hero-slider" aria-label="Belaro machining highlights" aria-roledescription="carousel" data-hero-slider data-home-module="hero">
  <div class="hero-backdrops" aria-hidden="true">
    {slides.map((slide, index) => <img class:list={['hero-backdrop', { 'is-active': index === 0 }]} src={slide.image} alt="" style={{ objectPosition: slide.position }} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} />)}
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-stage" aria-live="off">
    {slides.map((slide, index) => (
      <div id={`hero-slide-${index + 1}`} class:list={['hero-slide', { 'is-active': index === 0 }]} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}: ${slide.label}`} aria-hidden={index !== 0} inert={index !== 0}>
        <div class="container hero-content">
          <span class="eyebrow eyebrow-light"><i></i>{slide.label}</span>
          {index === 0 ? <h1>{slide.title}<br/><em>{slide.accent}</em></h1> : <h2 class="hero-title">{slide.title}<br/><em>{slide.accent}</em></h2>}
          <p>{slide.text}</p>
          <div class="hero-actions">
            <a class="button button-orange" href="/contact/">Request a Quote <span aria-hidden="true">↗</span></a>
            <a class="text-link text-link-light" href={slide.link}>{slide.action}<span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="container hero-footer">
    <div class="hero-proof">
      <div><strong>3-axis / 3+2 / 5-axis</strong><small>CNC milling configurations</small></div>
      <div><strong>CNC Turning</strong><small>Rotational components</small></div>
      <div><strong>OEM Focus</strong><small>Drawing-based production</small></div>
    </div>
    <div class="hero-controls" hidden>
      <div class="hero-pagination" role="group" aria-label="Choose a slide">
        {slides.map((slide, index) => <button type="button" class="hero-page" aria-label={`Show slide ${index + 1}: ${slide.label}`} aria-controls={`hero-slide-${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-slide={index}><span></span></button>)}
      </div>
      <div class="hero-navigation">
        <button type="button" data-previous aria-label="Previous slide">←</button>
        <span class="hero-counter"><b data-current>01</b><span>/</span>04</span>
        <button type="button" data-next aria-label="Next slide">→</button>
        <button type="button" class="hero-playback" data-playback aria-label="Pause slideshow"><span aria-hidden="true">Ⅱ</span></button>
      </div>
    </div>
  </div>
  <span class="hero-announcement" role="status" aria-live="polite" aria-atomic="true"></span>
</section>

<style>
  .hero-slider{display:block;padding:70px 0 30px;isolation:isolate;touch-action:pan-y}
  .hero-backdrops,.hero-backdrop{position:absolute;inset:0;width:100%;height:100%}
  .hero-backdrops,.hero-shade{z-index:-1;pointer-events:none}
  .hero-backdrop{object-fit:cover;opacity:0;transition:opacity .7s ease}
  .hero-backdrop.is-active{opacity:.65}
  .hero-stage{display:grid}
  .hero-slide{grid-area:1/1;min-width:0;opacity:0;visibility:hidden;transition:opacity .5s ease}
  .hero-slide.is-active{opacity:1;visibility:visible}
  .hero-content{padding-top:0;padding-bottom:0}
  .hero-title{font-size:clamp(43px,6vw,72px);line-height:1.12;font-weight:700;margin:23px 0 22px;max-width:960px}
  .hero-footer{position:relative}
  .hero-proof{margin-top:65px}
  .hero-controls{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:32px}
  .hero-controls[hidden]{display:none}
  .hero-pagination,.hero-navigation{display:flex;align-items:center;gap:10px}
  .hero-controls button{display:inline-grid;place-items:center;width:44px;height:44px;padding:0;background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;font:600 20px var(--font);cursor:pointer;transition:background .2s,border-color .2s}
  .hero-controls button:hover{background:rgba(255,255,255,.12);border-color:var(--orange)}
  .hero-controls button:focus-visible{outline:2px solid var(--orange);outline-offset:4px}
  .hero-controls .hero-page{width:44px;border:0}
  .hero-page span{display:block;width:100%;height:3px;background:rgba(255,255,255,.35);transition:background .2s}
  .hero-page[aria-current=true] span{background:var(--orange)}
  .hero-counter{display:flex;gap:12px;align-items:center;padding:0 8px;font:700 16px var(--display);font-variant-numeric:tabular-nums;letter-spacing:2px}
  .hero-counter>span{color:var(--orange)}
  .hero-playback{margin-left:6px}
  .hero-announcement{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  @media(max-width:700px){
    .hero-slider{padding-top:48px;padding-bottom:20px}
    .hero-title,.hero-content h1{font-size:clamp(34px,8.8vw,43px);overflow-wrap:break-word}
    .hero-content .eyebrow{font-size:12px;letter-spacing:1.3px}
    .hero-proof{margin-top:38px}
    .hero-controls{margin-top:24px;gap:8px;flex-wrap:wrap}
    .hero-pagination{gap:6px}
    .hero-controls .hero-page{width:28px}
    .hero-navigation{gap:5px}
    .hero-counter{gap:6px;padding:0 4px;font-size:14px}
    .hero-playback{margin-left:0}
  }
  @media(prefers-reduced-motion:reduce){.hero-slide,.hero-backdrop,.hero-controls button,.hero-page span{transition:none}}
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero-slide')];
    const backgrounds = [...hero.querySelectorAll<HTMLElement>('.hero-backdrop')];
    const pages = [...hero.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const playback = hero.querySelector<HTMLButtonElement>('[data-playback]')!;
    const counter = hero.querySelector<HTMLElement>('[data-current]')!;
    const announcement = hero.querySelector<HTMLElement>('.hero-announcement')!;
    let current = 0;
    let paused = false;
    let hovered = false;
    let focused = false;
    let visible = true;
    let timer: ReturnType<typeof setTimeout> | undefined;

    function schedule() {
      clearTimeout(timer);
      if (!paused && !hovered && !focused && visible && !document.hidden) {
        timer = setTimeout(() => show(current + 1), 7000);
      }
    }
    function show(index: number, manual = false) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.inert = !active;
        backgrounds[i].classList.toggle('is-active', active);
        if (active) pages[i].setAttribute('aria-current', 'true');
        else pages[i].removeAttribute('aria-current');
      });
      counter.textContent = String(current + 1).padStart(2, '0');
      if (manual) announcement.textContent = slides[current].getAttribute('aria-label');
      schedule();
    }
    function updatePlayback() {
      playback.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      playback.firstElementChild!.textContent = paused ? '▶' : 'Ⅱ';
      schedule();
    }
    hero.querySelector('[data-previous]')!.addEventListener('click', () => show(current - 1, true));
    hero.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1, true));
    pages.forEach((page, i) => page.addEventListener('click', () => show(i, true)));
    playback.addEventListener('click', () => { paused = !paused; updatePlayback(); });
    hero.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      // Keep focus on a visible control before the outgoing slide becomes inert.
      if ((event.target as HTMLElement).closest('.hero-slide')) pages[current].focus();
      show(current + (event.key === 'ArrowRight' ? 1 : -1), true);
    });
    hero.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') { hovered = true; schedule(); } });
    hero.addEventListener('pointerleave', () => { hovered = false; schedule(); });
    hero.addEventListener('focusin', () => { focused = true; schedule(); });
    hero.addEventListener('focusout', (event) => { focused = hero.contains(event.relatedTarget as Node | null); schedule(); });
    let touchStart: { x: number; y: number } | undefined;
    hero.addEventListener('touchstart', (event) => {
      touchStart = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : undefined;
    }, { passive: true });
    hero.addEventListener('touchend', (event) => {
      if (!touchStart || !event.changedTouches.length) return;
      const dx = event.changedTouches[0].clientX - touchStart.x;
      const dy = event.changedTouches[0].clientY - touchStart.y;
      touchStart = undefined;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        if (slides[current].contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
        show(current + (dx < 0 ? 1 : -1), true);
      }
    }, { passive: true });
    hero.addEventListener('touchcancel', () => { touchStart = undefined; });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }, { threshold: 0.15 }).observe(hero);
    hero.querySelector<HTMLElement>('.hero-controls')!.hidden = false;
    updatePlayback();
  }
</script>

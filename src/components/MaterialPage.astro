---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import RfqForm from './RfqForm.astro';
import ProcessImage from './ProcessImage.astro';
import { images } from '../data/images';
import type { MaterialPage } from '../data/material-pages';
interface Props { material: MaterialPage }
const { material } = Astro.props;
---
<BaseLayout title={`${material.name} CNC Machining for OEM Components`} description={material.description}>
  <Header quoteHref="#rfq-form" />
  <main class="material-page">
    <section class="material-hero" aria-labelledby="material-title">
      <Image class="hero-photo" src={images[material.image]} alt="CNC equipment machining a component; process context, not verification of the specified material" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="container hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="#grades">Materials</a><span aria-hidden="true">/</span><span aria-current="page">{material.name}</span></nav>
        <span class="eyebrow">{material.name} CNC Machining</span>
        <h1 id="material-title">{material.title}</h1><p>{material.intro}</p>
        <a class="button button-orange" href="#rfq-form">Request a Quote <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <nav class="section-index" aria-label="Page sections"><div class="container">{material.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#faq">FAQ</a><a href="#rfq-form">Request a Quote</a></div></nav>
    {material.sections.map((section, index) => <section class:list={['section', { 'section-soft': index % 2 === 1 }]} id={section.id} aria-labelledby={`${section.id}-title`}><div class="container">
      <div class="section-heading"><span class="eyebrow">{String(index + 1).padStart(2, '0')} / {material.name}</span><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.intro}</p></div>
      <div class="review-list">{section.items.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
      {section.link && <a class="text-link section-link" href={section.link[0]}>{section.link[1]} <span aria-hidden="true">&#8594;</span></a>}
      {['quality', 'stability'].includes(section.id) && <div class="inspection-image"><ProcessImage name="quality-critical-dimension-check" alt="Dimensional inspection process context; measurement scope is agreed per project" /><p>Inspection context only. Equipment, material records and report coverage are confirmed during quotation.</p></div>}
    </div></section>)}
    <section class="section section-soft" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div><span class="eyebrow">BEFORE YOU ENQUIRE</span><h2 id="faq-title">Frequently Asked Questions</h2></div><div class="faq-list">{material.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
    <section class="section" id="quote" aria-labelledby="quote-title"><div class="container rfq-layout"><div class="rfq-intro"><span class="eyebrow">REQUEST A QUOTE</span><h2 id="quote-title">Your drawing.<br/>Our technical review.</h2><p>Upload your drawing for a {material.name.toLowerCase()} machining review and quotation.</p><p>{material.rfq}</p><p>One file up to 20 MB; use a ZIP for multiple drawings and models. Material availability, process scope, documents, price and estimated lead time are confirmed during quotation.</p><a class="text-link" href="/contact/">Contact Belaro <span aria-hidden="true">&#8594;</span></a></div><RfqForm /></div></section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .material-page{letter-spacing:0}.material-page h1,.material-page h2,.material-page h3,.material-page .eyebrow{letter-spacing:0}
  .material-hero{position:relative;isolation:isolate;background:var(--navy);color:#fff}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.material-hero::before{content:"";position:absolute;inset:0;background:rgba(9,23,42,.72);z-index:-1}.hero-copy{padding-block:40px 64px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;color:#d0d8e2;margin-bottom:36px}.hero-copy .eyebrow{color:#fff}.hero-copy h1{font-size:52px;max-width:920px;line-height:1.16;margin:18px 0 22px}.hero-copy>p{max-width:710px;font-size:18px;color:#e0e6ee;margin-bottom:28px}
  .section-index{border-bottom:1px solid var(--line);background:var(--soft)}.section-index>div{display:flex;flex-wrap:wrap;gap:12px 28px;padding-block:22px}.section-index a{font-size:16px;color:var(--muted)}.section-index a:hover{color:var(--orange)}
  h2{font-size:36px;line-height:1.25;margin:14px 0 24px}h3{font-size:22px;line-height:1.35;margin:0}p{color:var(--muted)}.section-heading{max-width:860px;margin-bottom:34px}.review-list{border-top:1px solid var(--line)}.review-list article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:40px;border-bottom:1px solid var(--line);padding:26px 0}.review-list p{margin:0}.section-link{margin-top:26px}.inspection-image{margin-top:36px;max-width:760px}.inspection-image p{margin:14px 0 0}.faq-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:64px}.faq-list details{border-bottom:1px solid var(--line);padding:22px 0}.faq-list details:first-child{border-top:1px solid var(--line)}.faq-list summary{font-weight:600;cursor:pointer}.faq-list p{margin:16px 0 0}.rfq-intro{min-width:0}.material-page a:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  @media(max-width:700px){.hero-copy{padding-block:28px 48px}.hero-copy h1{font-size:36px;overflow-wrap:break-word}.hero-copy>p{font-size:16px}.breadcrumbs{margin-bottom:28px}h2{font-size:30px;overflow-wrap:break-word}.review-list article,.faq-layout{grid-template-columns:minmax(0,1fr);gap:14px}.section-index>div{gap:12px 20px}.faq-layout{gap:8px}}
</style>
